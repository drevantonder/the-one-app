<!-- The Windows app: packaged as MSIX (signed with the certificate build.ps1 names), since the Widgets board takes
     widgets only from a packaged app, and on the Windows App SDK's runtime package rather than a copy of it, whose
     registration is what lets the board reach the widgets (Customize, Done). .NET comes with it. build.sh writes
     WhiteLabel.g.cs, Package.appxmanifest's details and Assets/ from config.toml before building. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>One</RootNamespace>
    <AssemblyName>$(AppFile)</AssemblyName>
    <Product>$(AppName)</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Program.cs starts it: the window, or the widgets' COM server. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>$(SigningCertificate)</PackageCertificateThumbprint>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxPackageDir>$(MSBuildProjectDirectory)\package\</AppxPackageDir>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The client library's C# (uniffi-bindgen-cs) passes buffers to it by pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinUI 3 and what it stands on (Mica, the window, WebView2), without the rest of the Windows App SDK. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <!-- The Widgets board's widget provider: IWidgetProvider, WidgetManager. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.6.4" />
    <!-- The runtime's packages, which the app depends on and build.ps1 installs. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.4" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The client library (client/ffi), which build.sh puts beside the sources. -->
    <Content Include="one_client_ffi.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
