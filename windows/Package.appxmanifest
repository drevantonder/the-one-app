<?xml version="1.0" encoding="utf-8"?>
<!-- The app as Windows installs it: its window, its notifications, its links (@CLI@://open?…, which widgets open it at, and links to your
     One App's address: the config's, or whichever the app signs in to, which it adds itself (Shell.Claim)), and the Widgets
     board's widgets, served by the same program started as a COM server (Program.cs, Widgets.cs). build.sh fills in
     the @…@ from config.toml, and repeats the widget's definition: the board pins only one of each definition, so
     there are a few alike, each showing whichever widget from your pages its person chooses. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap7="http://schemas.microsoft.com/appx/manifest/uap/windows10/7"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap7 com desktop rescap">
  <Identity Name="@ID@" Publisher="@PUBLISHER@" Version="@VERSION@" />
  <Properties>
    <DisplayName>@NAME@</DisplayName>
    <PublisherDisplayName>@NAME@</PublisherDisplayName>
    <Logo>Assets\Store.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="@FILE@.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="@NAME@" Description="Your devices, and your team’s, as one place for apps and agents."
        BackgroundColor="transparent" Square150x150Logo="Assets\Tile.png" Square44x44Logo="Assets\Small.png" />
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="@CLI@">
            <uap:DisplayName>@NAME@</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <uap3:Extension Category="windows.appUriHandler">
          <uap3:AppUriHandler uap7:Name="links">
            <uap3:Host Name="@HOST@" />
          </uap3:AppUriHandler>
        </uap3:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="@FILE@.exe" Arguments="-RegisterProcessAsComServer" DisplayName="@NAME@ widgets">
              <com:Class Id="@WIDGETS@" DisplayName="@NAME@ widgets" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <!-- Its toasts' clicks and buttons start it (Notes.cs); and WNS's pushes, by the white label's Microsoft Entra app
             (config.toml's wns_app), which build.sh leaves out for a white label without one. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="@NOTES@" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="@FILE@.exe" Arguments="----AppNotificationActivated:" DisplayName="@NAME@ notifications">
              <com:Class Id="@NOTES@" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <!--wns-->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="@FILE@.exe" Arguments="----WindowsAppRuntimePushServer:" DisplayName="@NAME@ pushes">
              <com:Class Id="@WNS_APP@" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <!--/wns-->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="@NAME@" Id="@CLI@">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\Small.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="@WIDGETS@" />
                </Activation>
                <Definitions>
                  <Definition Id="widget@N@" DisplayName="@NAME@" Description="A widget from one of your pages." IsCustomizable="true">
                    <Capabilities>
                      <Capability><Size Name="small" /></Capability>
                      <Capability><Size Name="medium" /></Capability>
                      <Capability><Size Name="large" /></Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Small.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Widget.png" DisplayAltText="A widget from one of your pages" />
                      </Screenshots>
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
