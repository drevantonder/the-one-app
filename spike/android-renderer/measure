#!/usr/bin/env bash
# measure <Web|Strict> <runs> [am start extras]: open-to-fully-drawn of the screen, by Android's own "Fully drawn" (reportFullyDrawn),
# cold (process killed first) and warm (process and engine already up, as an app screen opens inside the One App).
set -euo pipefail
adb=$HOME/Android/Sdk/platform-tools/adb
pkg=app.theone.strictspike
activity=$pkg/.${1}Activity
drawn() { timeout 20 "$adb" logcat -m 1 -e "Fully drawn $activity" | grep -o '+[0-9]*s*[0-9]*ms' | tr -d '+'; }
for mode in cold warm; do
  "$adb" shell am force-stop $pkg
  if [ $mode = warm ]; then "$adb" logcat -c; "$adb" shell am start -n $activity "${@:3}" >/dev/null; drawn >/dev/null; "$adb" shell input keyevent 4; fi
  times=()
  for _ in $(seq "$2"); do
    [ $mode = cold ] && "$adb" shell am force-stop $pkg
    "$adb" logcat -c
    "$adb" shell am start -n $activity "${@:3}" >/dev/null
    times+=("$(drawn)")
    [ $mode = warm ] && "$adb" shell input keyevent 4
  done
  echo "$1 $mode: ${times[*]}"
done
