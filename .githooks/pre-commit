#!/bin/sh
# Git runs this before each commit, once the clone has `git config core.hooksPath .githooks`.

# A commit is made in a worktree of its own, never in the clone's main checkout, which every thread on the machine
# shares.
dirs=$(git rev-parse --path-format=absolute --git-dir --git-common-dir)
[ "$(echo "$dirs" | sed -n 1p)" != "$(echo "$dirs" | sed -n 2p)" ] || {
  echo "$(pwd) is this clone's main checkout, which every thread on this machine works beside. Commit from a worktree of your own: \`git worktree add <path> -b <branch> origin/main\`, and carry your change there (\`git diff HEAD > <file>\`, then \`git apply <file>\` in it)." >&2
  exit 1
}

# A folder that moved leaves nothing behind where it was: a file still there is one the move missed, as two builds
# left in plugins/ by the rename to apps/ were (1f5d085ee). A folder moved is one whose files moved with the same
# path under it.
moved=$(git diff --cached -M --diff-filter=R --name-status | awk -F'\t' '{
  n = split($2, old, "/"); m = split($3, new, "/")
  for (k = 0; k < n && k < m && old[n - k] == new[m - k]; k++);
  if (k >= 2) { folder = old[1]; for (i = 2; i <= n - k + 1; i++) folder = folder "/" old[i]; print folder }
}' | sort -u)
left=$(for folder in $moved; do git ls-files -- "$folder/"; done)
[ -z "$left" ] || {
  echo "These are still in a folder this commit moves, which the move missed: move them with it, or remove them:" >&2
  echo "$left" | sed 's/^/    /' >&2
  exit 1
}

# The tokens' CSS is made from tokens.ts (core/ui/tables.ts): a commit with one has the other as it makes it.
if git diff --cached --name-only | grep -q '^core/ui/src/tokens\.\(ts\|css\)$'; then
  made=$(cd core/ui && bun tables.ts) || exit 1
  [ "$made" = "$(git show :core/ui/src/tokens.css)" ] || {
    echo "core/ui/src/tokens.css isn't what core/ui/src/tokens.ts makes: run \`bun tables.ts > src/tokens.css\` in core/ui, and add it." >&2
    exit 1
  }
fi

# An app's page is checked against the UI library as a server checks it where it deploys it (`lint:app`, as
# `OneCore.Entrypoint.lint/3` runs it), where the network would otherwise refuse the app's update after it's pushed.
for app in $(git diff --cached --name-only --diff-filter=d | sed -n 's|^apps/\([^/]*\)/client/.*|\1|p' | sort -u); do
  [ -f "apps/$app/client/tsconfig.json" ] || continue
  (cd core/ui && bun install --frozen-lockfile --ignore-scripts --silent) || exit 1
  (cd "apps/$app/client" && [ ! -f package.json ] || bun install --frozen-lockfile --ignore-scripts --silent) || exit 1
  bun core/ui/lint-app.js "apps/$app/client" >&2 || {
    echo "apps/$app/client fails the UI library's check above, which every deploy runs, so the network would refuse it." >&2
    exit 1
  }
done
