#!/bin/sh
# Git runs this after a checkout, once the clone has `git config core.hooksPath .githooks`.

# A new worktree (whose checkout before is git's null commit) starts from a copy of the build of the worktree beside
# it that built last: what Cargo, Mix and bun build into (`target/`, `_build/`, `deps/`, `node_modules/`). On a file
# system that shares a copy's blocks, as btrfs does here, it's copied at once and takes no room. Each tool then
# builds what differs, as it does in the worktree it came from: the workspace's own crates and One Core, in seconds,
# rather than every package they use, in minutes. Where it can't be copied that way, nothing is.
[ "$1" = 0000000000000000000000000000000000000000 ] || exit 0
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
here=$(pwd)

git worktree list --porcelain | sed -n 's/^worktree //p' | while read -r there; do
  [ "$there" = "$here" ] || stat -c "%Y $there" "$there/target/debug/one" 2>/dev/null
done | sort -rn | cut -d' ' -f2- | while read -r there; do
  # Cargo holds this lock while it builds there, and a copy taken meanwhile could be half of a build.
  lock=$there/target/debug/.cargo-build-lock
  [ -e "$lock" ] || continue
  folders=$(git -C "$there" ls-files -oi --exclude-standard --directory | grep -E '(^|/)(target|_build|deps|node_modules)/$')
  if flock -n -s "$lock" sh -c 'from=$1 && shift && for folder; do
       mkdir -p "$(dirname "$folder")" && cp -a --reflink=always "$from/$folder" "$folder" || exit 1
     done' sh "$there" $folders; then
    # What was copied may have been built since this checkout was written, from another commit, and Cargo and Mix
    # tell what to build again by which is newer.
    git ls-files -z | xargs -0 touch -c --
    echo "Copied the build of $there"
    break
  fi
  for folder in $folders; do rm -rf "./$folder"; done
done
exit 0
