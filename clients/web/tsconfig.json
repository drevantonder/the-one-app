// The page is JavaScript, which the edge bundles with what it imports (`core/edge/edge.js`), and TypeScript checks it: `bunx --package typescript@7.0.2 tsc -p .`.
{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["host.js"]
}
