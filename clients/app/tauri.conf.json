{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The One App",
  "identifier": "app.theone.client",
  "build": {
    "frontendDist": ["page/index.html", "page/client.css", "page/client.js", "page/host.js", "../../icons/Logo.png", "../../ui/src/tokens.css", "../../ui/src/ui.css", "../../ui/src/Geist-Variable.woff2", "../../ui/src/GeistMono-Variable.woff2", "../../ui/src/Geist-LICENSE.txt"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; frame-src oneapp: http://*.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "icon": ["../../icons/AppIcon@2x.png"]
  }
}
