// The page is JavaScript, served as it is with no build, and TypeScript checks it: `bunx --package typescript@7.0.2 tsc -p .`,
// with XState's types from the UI library's packages (`bun install` in core/ui).
{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "paths": { "xstate": ["../../../core/ui/node_modules/xstate"] },
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.js", "*.d.ts"]
}
