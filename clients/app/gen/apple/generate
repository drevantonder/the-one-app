#!/bin/sh
# Makes app.xcodeproj from project.yml for the app a Tauri config names, which is the One App's own
# (`clients/app/tauri.conf.json`), or a network's, as `cargo tauri ios build --config <its file>` merges it:
#
#     ./generate [<its file>]
#
# Its identifier names the app, its notification extension and the App Group they share, so they line up. The hosts
# of its app links (`plugins.deep-link.mobile`) are its network's, whose passkeys the app's web view uses
# (`webcredentials`), as each one's `/.well-known/apple-app-site-association` says; the deep-link plugin adds the
# app links themselves (`applinks`) as the app is built.
set -e
here=$(cd "$(dirname "$0")" && pwd)
named() { plutil -extract identifier raw -o - "$1" 2>/dev/null; }
ONE_IDENTIFIER=$( { [ -n "${1-}" ] && named "$1"; } || named "$here/../../tauri.conf.json")
ONE_NAME=$( { [ -n "${1-}" ] && plutil -extract productName raw -o - "$1" 2>/dev/null; } || plutil -extract productName raw -o - "$here/../../tauri.conf.json")
export ONE_IDENTIFIER ONE_NAME
[ -n "${1-}" ] && config=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
cd "$here" && xcodegen generate
[ -n "${config-}" ] || exit 0
entitlements="$here/app_iOS/app_iOS.entitlements"
domains=":com.apple.developer.associated-domains"
i=0
while plutil -extract "plugins.deep-link.mobile.$i" json -o /dev/null "$config" 2>/dev/null; do
  if host=$(plutil -extract "plugins.deep-link.mobile.$i.host" raw -o - "$config" 2>/dev/null); then
    /usr/libexec/PlistBuddy -c "Print $domains" "$entitlements" >/dev/null 2>&1 || /usr/libexec/PlistBuddy -c "Add $domains array" "$entitlements"
    /usr/libexec/PlistBuddy -c "Add $domains: string webcredentials:$host" "$entitlements"
  fi
  i=$((i + 1))
done
