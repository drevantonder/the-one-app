#!/bin/sh
# Makes app.xcodeproj from project.yml for the One App, as `clients/app/tauri.conf.json` names it:
#
#     ./generate
#
# Its identifier names the app, its notification extension and the App Group they share, so they line up. A network's
# own app is this one, finished for it once it's built (`tooling/testflight`).
set -e
here=$(cd "$(dirname "$0")" && pwd)
config=$here/../../tauri.conf.json
ONE_IDENTIFIER=$(plutil -extract identifier raw -o - "$config")
ONE_NAME=$(plutil -extract productName raw -o - "$config")
export ONE_IDENTIFIER ONE_NAME
cd "$here" && xcodegen generate
