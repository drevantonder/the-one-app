<?xml version="1.0" encoding="utf-8"?>
<!-- Computer Use on this phone (ComputerUse.kt): it sees the screen, takes screenshots, touches it and reads the field
     that has the focus, to type there. It listens to nothing that happens on the screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/computer_use_description"
    android:summary="@string/computer_use_summary"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:isAccessibilityTool="false"
    android:notificationTimeout="1000" />
