<!-- The package: the app's own program (the Tauri one, client/native, cross-built by build.sh) as its app, and this
     helper (Helper.cs) beside it, for what only the Windows App SDK does: the Widgets board's provider, toasts and
     pushes. Packaged as MSIX (signed with the certificate build.ps1 names), since the board takes widgets, and Windows
     shows a badge, only from a packaged app; on the Windows App SDK's runtime package rather than a copy of it, whose
     registration is what lets the board reach the widgets (Customize, Done). .NET comes with it. build.sh writes
     CustomBuild.g.cs, Package.appxmanifest's details and Assets/ from config.toml before building. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>One</RootNamespace>
    <AssemblyName>$(AppFile)Helper</AssemblyName>
    <Product>$(AppName)</Product>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>$(SigningCertificate)</PackageCertificateThumbprint>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxPackageDir>$(MSBuildProjectDirectory)\package\</AppxPackageDir>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Toasts and pushes (AppNotificationManager, PushNotificationManager) and how it was started (AppInstance). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.4" />
    <!-- The Widgets board's widget provider: IWidgetProvider, WidgetManager. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.6.4" />
    <!-- The runtime's packages, which the package depends on and build.ps1 installs. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.4" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The app's own program and the WebView2 loader it starts its window with, which build.sh puts in app\. -->
    <Content Include="app\**" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
