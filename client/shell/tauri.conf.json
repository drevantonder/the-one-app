{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The One App",
  "identifier": "app.theone.client",
  "build": {
    "frontendDist": ["page/index.html", "page/home.css", "page/home.js", "../../ui/src/tokens.css"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src data:; frame-src oneapp: http://*.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "icon": ["../../icons/AppIcon.png"]
  }
}
