#!/usr/bin/env bun
// Makes the Windows programs it's given the One App's in their version resources and icon, which Windows shows a
// program by: in Windows Firewall's prompt (its name, its icon and, for a program that isn't signed, its publisher,
// which is CompanyName) and its list of allowed apps, among others. A program with no version resource, as Rust builds
// one, has one made, of version VERSION. Its OriginalFilename is its file's name. Erlang/OTP's copyright stays in its
// VM's, after ours. A signed program, as Erlang/OTP's are, is left unsigned, as a changed one's signature no longer
// holds.
import * as ResEdit from "resedit@3.1.1";
import * as PE from "pe-library@1.0.1";
import { readFileSync, writeFileSync } from "node:fs";
import { basename, join } from "node:path";
import { fileURLToPath } from "node:url";

const root = fileURLToPath(new URL("..", import.meta.url));
const copyright = readFileSync(join(root, "LICENSE"), "utf8").match(/^Copyright .*$/m)[0];
const icon = ResEdit.Data.IconFile.from(readFileSync(join(root, "icons/AppIcon.ico")));

for (const file of process.argv.slice(2)) {
  const exe = PE.NtExecutable.from(readFileSync(file), { ignoreCert: true });
  const resources = PE.NtExecutableResource.from(exe);
  let [version] = ResEdit.Resource.VersionInfo.fromEntries(resources.entries);
  if (!version) {
    version = ResEdit.Resource.VersionInfo.create({ lang: 1033, fixedInfo: {}, strings: [] });
    version.setFileVersion(process.env.VERSION, 1033);
    version.setProductVersion(process.env.VERSION, 1033);
  }
  const languages = version.getAllLanguagesForStringValues();
  for (const language of languages.length ? languages : [{ lang: 1033, codepage: 1200 }]) {
    const theirs = version.getStringValues(language).LegalCopyright;
    version.setStringValues(language, {
      CompanyName: "the One App",
      ProductName: "the One App",
      FileDescription: "the One App",
      LegalCopyright: theirs ? `${copyright}. ${theirs}` : copyright,
      OriginalFilename: basename(file),
    });
  }
  version.outputToResourceEntries(resources.entries);
  // Windows shows a program by its first icon group.
  const [group] = ResEdit.Resource.IconGroupEntry.fromEntries(resources.entries);
  ResEdit.Resource.IconGroupEntry.replaceIconsForResource(
    resources.entries,
    group?.id ?? 1,
    group?.lang ?? 1033,
    icon.icons.map((item) => item.data),
  );
  resources.outputResource(exe);
  writeFileSync(file, Buffer.from(exe.generate()));
}
