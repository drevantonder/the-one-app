#!/bin/sh
# Says the version of this checkout, which is the one name its build has everywhere: `one --version`, the `builds`
# tool, a server, the edge, and a phone's app. It's Semantic Versioning's, `0.15.2+2974.febd37350abc`: the
# platform's version, then as build metadata how many commits lead to the one checked out, which only grows on main
# and is what a phone's store takes as its build number, and that commit, with `.dirty` after when what's built
# isn't all committed.
#
# The version is the commits' since 0.15.0, by their Conventional Commit types, as semantic-release reads them, and
# as Cargo, npm and Hex read 0.x: a breaking change (`type!:`, or a `BREAKING CHANGE:` footer) takes the next minor
# before 1.0 and the next major from it, a `feat` the next patch before 1.0 and the next minor from it, and a `fix`
# the next patch. Anything else leaves it as it is.
set -e
cd "$(dirname "$0")/.."
# 0.15.0 is the commit before builds had versions.
since=6ab2c6a02
# Commits marked breaking that weren't, read as what they are: main is shared, so a pushed commit's message can't be
# changed.
mismarked="4b6c917ff2581cc84a6fd3c81c40d5f713ff1360"
version=$(git log --reverse --format='%H%n%s%n%b%x1e' "$since..HEAD" | awk -v version=0.15.0 -v mismarked="$mismarked" '
  BEGIN { RS = "\036"; split(version, v, "."); major = v[1]; minor = v[2]; patch = v[3] }
  {
    sub(/^\n+/, "")
    hash = $0
    sub(/\n.*/, "", hash)
    sub(/^[^\n]*\n/, "")
    subject = $0
    sub(/\n.*/, "", subject)
    if (index(mismarked, hash) > 0) sub(/!:/, ":", subject)
    if (index(mismarked, hash) == 0 && (subject ~ /^[a-z]+(\([^)]*\))?!:/ || $0 ~ /\nBREAKING[ -]CHANGE:/)) {
      if (major == 0) minor++; else { major++; minor = 0 }
      patch = 0
    } else if (subject ~ /^feat(\([^)]*\))?:/) {
      if (major == 0) patch++; else { minor++; patch = 0 }
    } else if (subject ~ /^fix(\([^)]*\))?:/) {
      patch++
    }
  }
  END { print major "." minor "." patch }')
commit=$(git describe --always --dirty=.dirty --abbrev=12 --exclude='*')
echo "$version+$(git rev-list --count HEAD).$commit"
