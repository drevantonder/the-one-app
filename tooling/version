#!/bin/sh
# Says the version of a part in this checkout: with no argument the platform's, which is the one name its build has
# everywhere: `one --version`, the `builds` tool, a server, the edge, and a phone's app; with an app's folder,
# `tooling/version apps/gmail`, that app's. It's Semantic Versioning's, `0.18.2+2974.febd37350abc`: the
# version, then as build metadata how many commits lead to the one checked out, which only grows on main and is what
# a phone's store takes as its build number, and that commit, with `.dirty` after when what's built isn't all
# committed, and the first 8 hex digits of a hash of what isn't (the diff from that commit and each untracked file),
# so each uncommitted state a local network or a test build runs has a name of its own, and nothing that keeps what
# a build had by its name keeps one's under another's: `0.18.2+2974.febd37350abc.dirty.3f9a0c21`.
#
# A version counts the Conventional Commits since 4706f3067 that touch its part's paths, as release-please's manifest
# mode, Nx Release and release-plz do: the message says what kind of change it is, the paths which part changed. A
# breaking change (`type!:`, or a `BREAKING CHANGE:` footer) takes the next minor before 1.0 and the next major from
# it, a `feat` the next patch before 1.0 and the next minor from it, and a `fix` the next patch, as Cargo, npm and Hex
# read 0.x. Anything else leaves it as it is, and a commit touching two parts moves each.
#
# `tooling/version parts <path>...` says which parts those paths are in, `platform` or `apps/<name>`, one a line.
set -e
cd "$(dirname "$0")/.."
platform="core clients icons Cargo.toml Cargo.lock mise.toml tooling/release"
# The platform was 0.18.40 there, counted from 0.15.0 by every commit; each app starts at 0.1.0.
since=4706f3067
case $1 in
  "") paths=$platform start=0.18.40 ;;
  apps/*) paths=$1 start=0.1.0 ;;
  parts)
    shift
    for path; do
      for part in $platform; do case $path in "$part" | "$part"/*) echo platform ;; esac; done
      case $path in apps/*/*) path=${path#apps/} && echo "apps/${path%%/*}" ;; esac
    done | sort -u
    exit ;;
  *) echo "tooling/version [apps/<name>], or tooling/version parts <path>..." >&2 && exit 1 ;;
esac
# shellcheck disable=SC2086 # the paths are words
version=$(git log --reverse --format='%s%n%b%x1e' "$since..HEAD" -- $paths | awk -v version=$start '
  BEGIN { RS = "\036"; split(version, v, "."); major = v[1]; minor = v[2]; patch = v[3] }
  {
    sub(/^\n+/, "")
    subject = $0
    sub(/\n.*/, "", subject)
    if (subject ~ /^[a-z]+(\([^)]*\))?!:/ || $0 ~ /\nBREAKING[ -]CHANGE:/) {
      if (major == 0) minor++; else { major++; minor = 0 }
      patch = 0
    } else if (subject ~ /^feat(\([^)]*\))?:/) {
      if (major == 0) patch++; else { minor++; patch = 0 }
    } else if (subject ~ /^fix(\([^)]*\))?:/) {
      patch++
    }
  }
  END { print major "." minor "." patch }')
commit=$(git describe --always --dirty=.dirty --abbrev=12 --exclude='*')
case $commit in
  *.dirty) commit=$commit.$({
    git diff HEAD --binary
    git ls-files --others --exclude-standard | while IFS= read -r file; do echo "$file $(git hash-object -- "$file")"; done
  } | git hash-object --stdin | cut -c1-8) ;;
esac
echo "$version+$(git rev-list --count HEAD).$commit"
