#!/usr/bin/env bash
# Builds a network's iPhone app at the commit checked out, which is on main, signs it for the App Store, uploads it to
# TestFlight, whose internal group has every build, and waits until Apple has processed it, when its testers' phones
# take it by themselves (the `iphone` skill says how each step is done, and why):
#
#     tooling/testflight <the network's repo>
#
# It builds only what a phone doesn't get otherwise: its page comes from the network's edge, and its apps from their
# servers, so a build whose native code, what Rust builds for the phone (`tooling/input-hash`) and its Xcode project
# (`clients/app/gen/apple`), is as TestFlight's latest build had it is left as it is, as is one a newer build there has
# the changes of. `tooling/release client` runs it for a network with an iPhone among its devices.
#
# Everything iPhone is done on the Mac `ssh mac` reaches, by this script there (`--on-mac`), at the lowest priority, as
# its person may be using it, in its checkout ~/scratch/testflight, kept between builds so each builds only what
# changed, one at a time, with the network's `app/` beside it in ~/scratch/testflight-network. Each line it prints
# says how many seconds into it it is. The build number is the commit's count of commits (`tooling/version`).
set -euo pipefail

# The team that signs the One App, and its App Store Connect API key, an Admin's, whose .p8 is in 1Password.
team=X96JC3HCV7
key_id=R49QVKSHMK
issuer=2dac44a7-07fb-45f2-85a8-e7f63345f838

if [[ ${1:-} == --on-mac ]]; then
  # On the Mac, in its checkout at the commit: archives the app unsigned, as no Apple account is signed in to Xcode
  # there, then exports it for the App Store, signed with the team's Apple Distribution certificate in the keychain,
  # unlocked in this connection, and each target's App Store profile, which Xcode fetches with the API key where it
  # hasn't one. It's manual signing: Xcode's automatic signing exports only with Apple's cloud-managed certificates,
  # which App Store Connect refuses this key (403). Then it uploads it with the key, which arrives on standard input
  # and is read first, before anything else reads what's there, into a folder of its own for these commands alone.
  keychain=$HOME/Library/Keychains/ptc-build.keychain-db
  work=$(mktemp -d) && trap 'rm -rf "$work"; security lock-keychain "$keychain"' EXIT
  cat >"$work/AuthKey_$key_id.p8" && exec </dev/null
  cd "$(dirname "$0")/../clients/app"
  network=$HOME/scratch/testflight-network/app
  git clean -qfdx gen/apple
  gen/apple/generate "$network/tauri.conf.json"
  TAURI_ONE_ADDRESS=$(cat "$network/address") APPLE_DEVELOPMENT_TEAM=$team \
    cargo tauri ios build --archive-only --no-sign --config "$network/tauri.conf.json"
  archive=gen/apple/build/app_iOS.xcarchive
  app=$(echo "$archive"/Products/Applications/*.app)
  # The export signs each target with the entitlements its binary has, so each is signed first, ad hoc, with its own:
  # the app's with its bundle identifier written in, as Xcode would have.
  id=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$app/Info.plist")
  sed "s/\$(PRODUCT_BUNDLE_IDENTIFIER)/$id/g" gen/apple/app_iOS/app_iOS.entitlements >"$work/app.entitlements"
  codesign --force --sign - --entitlements gen/apple/Notifications/Notifications.entitlements "$app/PlugIns/Notifications.appex"
  codesign --force --sign - --entitlements "$work/app.entitlements" "$app"
  cat >"$work/export.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>method</key><string>app-store-connect</string>
  <key>teamID</key><string>$team</string>
  <key>signingStyle</key><string>manual</string>
  <key>signingCertificate</key><string>Apple Distribution</string>
  <key>provisioningProfiles</key><dict>
    <key>$id</key><string>The One App App Store</string>
    <key>$id.notifications</key><string>The One App Notifications App Store</string>
  </dict>
</dict></plist>
PLIST
  printf 'unlock-keychain -p "%s" "%s"\n' "$(cat ~/.config/ptc/build-keychain-pw)" "$keychain" | security -i >/dev/null
  auth=(-authenticationKeyPath "$work/AuthKey_$key_id.p8" -authenticationKeyID "$key_id" -authenticationKeyIssuerID "$issuer")
  xcodebuild -exportArchive -archivePath "$archive" -exportOptionsPlist "$work/export.plist" -exportPath "$work/out" -allowProvisioningUpdates "${auth[@]}"
  (cd "$work" && unzip -q out/*.ipa -d signed && codesign --verify --strict --deep signed/Payload/*.app)
  API_PRIVATE_KEYS_DIR=$work xcrun altool --upload-app -f "$work"/out/*.ipa -t ios --apiKey "$key_id" --apiIssuer "$issuer"
  exit
fi

[[ -d ${1:-} ]] || { echo "tooling/testflight <the network's repo>" >&2 && exit 1; }
network=$(cd "$1" && pwd)
cd "$(dirname "$0")/.."
[[ $(uname) != Linux ]] || exec > >(while IFS= read -r line; do printf '%4ds %s\n' "$SECONDS" "$line"; done) 2>&1
ASC_KEY=$(op document get "PTC Builds App Store Connect API key (key $key_id)" --vault ptc-nosudo) || exit 1
export ASC_KEY key_id issuer

# Asks App Store Connect's API for `$1`, with a token its key signs (ES256, for 20 minutes).
asc() {
  bun -e '
    const { createPrivateKey, sign } = require("node:crypto");
    const { ASC_KEY, key_id, issuer } = process.env;
    const part = (it) => Buffer.from(JSON.stringify(it)).toString("base64url");
    const now = Math.floor(Date.now() / 1000);
    const unsigned = `${part({ alg: "ES256", kid: key_id, typ: "JWT" })}.${part({ iss: issuer, iat: now, exp: now + 1200, aud: "appstoreconnect-v1" })}`;
    const signature = sign("sha256", Buffer.from(unsigned), { key: createPrivateKey(ASC_KEY), dsaEncoding: "ieee-p1363" }).toString("base64url");
    const response = await fetch(`https://api.appstoreconnect.apple.com${process.argv[1]}`, { headers: { authorization: `Bearer ${unsigned}.${signature}` } });
    if (!response.ok) throw new Error(`App Store Connect said ${response.status} to ${process.argv[1]}: ${await response.text()}`);
    console.log(await response.text());
  ' "$1"
}

# The network's app as its repo's main has it on the remote, which is what's built, whatever its checkout here has:
# only its objects are read, never its files.
git -C "$network" fetch -q origin main
identifier=$(git -C "$network" show origin/main:app/tauri.conf.json | jq -r '.identifier // empty')
identifier=${identifier:-$(jq -r .identifier clients/app/tauri.conf.json)}
app=$(asc "/v1/apps?filter%5BbundleId%5D=$identifier" | jq -r '.data[0].id // empty')
[[ -n $app ]] || { echo "App Store Connect has no app $identifier: its owner makes it on the website." >&2 && exit 1; }
build=$(tooling/version)
number=${build#*+} && number=${number%%.*}
commit=$(git rev-parse HEAD)

# The phone's native code at commit `$1`: what Rust builds for it, its Xcode project and the protocols it speaks.
native() {
  local at
  at=$(mktemp -d)
  git worktree add -q --detach "$at" "$1"
  (cd "$at" && tooling/input-hash clients/app aarch64-apple-ios && git ls-files -s clients/app/gen/apple core/protocol.json) | sha256sum | cut -d' ' -f1
  git worktree remove --force "$at"
}

# TestFlight's latest build, by its number, which is a commit's count on main.
latest=$(asc "/v1/builds?filter%5Bapp%5D=$app&sort=-version&limit=1&fields%5Bbuilds%5D=version" | jq -r '.data[0].attributes.version // empty')
if [[ -n $latest ]]; then
  ((latest < number)) || { echo "TestFlight has $latest, which has $build's changes" && exit 0; }
  git fetch -q origin main
  was=$(git rev-list --reverse origin/main | sed -n "${latest}p")
  if [[ -n $was && $(native "$was") == $(native "$commit") ]]; then
    echo "$build's native code is as TestFlight's $latest has it: the phone takes its page and apps without a build" && exit 0
  fi
fi

echo "Building $build for TestFlight on the Mac, as $number"
mac() { ssh -o ConnectTimeout=15 mac "zsh -lc $(printf %q "set -e; export PATH=\$HOME/.local/bin:\$HOME/.cargo/bin:\$PATH CARGO_BUILD_JOBS=4; $1")"; }
git -C "$network" archive --format=tar origin/main app |
  mac "rm -rf ~/scratch/testflight-network && mkdir -p ~/scratch/testflight-network && tar -x -C ~/scratch/testflight-network"
mac "lockf -k ~/scratch/testflight.lock bash -c $(printf %q "set -e
  [[ -d ~/scratch/testflight ]] || git clone -q https://github.com/drevantonder/the-one-app.git ~/scratch/testflight
  cd ~/scratch/testflight && git fetch -q origin $commit && git reset -q --hard $commit
  nice -n 19 taskpolicy -d throttle tooling/testflight --on-mac")" <<<"$ASC_KEY"
echo "Uploaded $number; waiting for Apple to process it"

# Apple tells of a processed build only by a webhook to a server of one's own, so this asks every 30 s, as fastlane's
# pilot does, for up to an hour.
until [[ $(asc "/v1/builds?filter%5Bapp%5D=$app&filter%5Bversion%5D=$number&fields%5Bbuilds%5D=processingState" | jq -r '.data[0].attributes.processingState // empty') == VALID ]]; do
  ((SECONDS < 3600)) || { echo "Apple hasn't processed $number within an hour" >&2 && exit 1; }
  sleep 30
done
echo "TestFlight has $number ($build): its testers' phones take it by themselves"
