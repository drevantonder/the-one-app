#!/usr/bin/env bash
# Builds every NIF and program a server needs, One Core's and those of this repo's apps, for each kind of machine
# a server runs on, or the kinds given, each beside its source: `core/server/nif/<crate>/<kind>.so`,
# which `tooling/release` puts in a server, and as an app brings them (`OneCore.App`),
# `apps/<name>/server/nif/<crate>/<kind>.so` and `apps/<name>/server/bin/<crate>/<kind>`. An app is the same
# files on every server of a network, so it's deployed with all of them:
#
#     tooling/nifs [kind...]
#
# Each kind is built in one place, so every build of a commit is the same bytes, and an app deployed again from
# an unchanged folder is unchanged: Linux's and Windows' on Linux, Linux's with zig for the same glibc as a server's VM
# (`tooling/release`) and Windows' with cargo-xwin, as a DLL, which is kept under the same kind of name,
# `windows-x86_64.so`; a Mac's on a Mac, with its own toolchain and SDK. A build is kept by what it's built from
# (`tooling/input-hash`), in this machine's cache, outside any worktree, so one whose inputs haven't changed is
# the one built before, by any worktree, and only a crate that changed is built. A Mac's too: from Linux, it's built
# on GitHub's macOS runner (`.github/workflows/nifs.yml`), from the same commit, which must be on GitHub, so what's
# built is committed, with the same Rust. That takes minutes, so before that, One Core's is looked for in the latest
# server published for a Mac, whose `nifs` lists what each NIF was built from, as `$target/nifs/<kind>` does for the ones here,
# which `tooling/release` puts in a server, and an app's where its `server/checksums.json` says it's published
# (`tooling/publish-nifs`).
#
# Each NIF is named for its build, what it's built from (`tooling/input-hash`), so a server loads a changed one beside
# the one before (`OneCore.Nif`). The runner is given the names this machine worked out, in NIF_BUILD_<CRATE>, so a
# Mac's NIF is named for what it's kept by here.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
# The tools Linux needs are the ones `mise.toml` names; a Mac needs only Rust.
[[ $(uname -s) != Linux ]] || command -v cargo-zigbuild >/dev/null || exec mise exec -C "$root" -- "$0" "$@"
cd "$root"

kinds=("$@")
((${#kinds[@]})) || kinds=(linux-x86_64 linux-aarch64 windows-x86_64 macos-aarch64)
here=$(uname -s)
crates=($(dirname core/server/nif/*/Cargo.toml apps/*/server/nif/*/Cargo.toml apps/*/server/bin/*/Cargo.toml))
target=${CARGO_TARGET_DIR:-$root/target}

declare -A sums=()
for kind in "${kinds[@]}"; do
  wrap=()
  case $kind in
    linux-x86_64 | linux-aarch64) triple=${kind#*-}-unknown-linux-gnu build="zigbuild --target $triple.2.35" library=lib%s.so ;;
    # One cargo-xwin build on a machine at a time, as `tooling/release` says.
    windows-x86_64) triple=x86_64-pc-windows-msvc build="xwin build --target $triple" library=%s.dll
      wrap=(flock -o "${XDG_CACHE_HOME:-$HOME/.cache}/cargo-xwin.lock") ;;
    macos-aarch64) triple=aarch64-apple-darwin build="build --target $triple" library=lib%s.dylib ;;
    *) echo "No server runs on $kind" >&2 && exit 1 ;;
  esac
  cache=${XDG_CACHE_HOME:-$HOME/.cache}/the-one-app/nifs
  mkdir -p "$cache" "$target/nifs"
  files=()
  for crate in "${crates[@]}"; do
    file=$crate/$kind && [[ $crate == */bin/* ]] || file+=.so
    sums[$file]=$(tooling/input-hash "$crate" "$triple") && files+=("$file")
  done
  builds=()
  for crate in "${crates[@]}"; do
    [[ $crate == */nif/* ]] || continue
    name=NIF_BUILD_$(basename "$crate" | tr '[:lower:]' '[:upper:]')
    builds+=("$name=${!name:-${sums[$crate/$kind.so]}}")
  done
  for file in "${files[@]}"; do echo "${sums[$file]} $file"; done | sort -k2 >"$target/nifs/$kind"
  changed() { for file in "${files[@]}"; do cp "$cache/${sums[$file]}" "$file" 2>/dev/null || echo "$file"; done; }
  # A build is renamed into the cache whole, so what another build reads is never half-written.
  keep() { cp "$1" "$cache/${sums[$1]}.$$" && mv "$cache/${sums[$1]}.$$" "$cache/${sums[$1]}"; }

  if [[ $kind == macos-* && $here == Linux ]]; then
    # An app's published build, named for what it's built from, checked against the SHA-256 published with it.
    for file in $(changed); do
      [[ $file == apps/* ]] || continue
      app=${file#apps/} && app=${app%%/*}
      read -r url sha256 < <(jq -r --arg path "${file#apps/"$app"/}" '.[$path] // empty | "\(.url) \(.sha256)"' \
        "apps/$app/server/checksums.json" 2>/dev/null) || continue
      [[ ${url##*/} == *-"${sums[$file]}"-* ]] && curl -fsSL -o "$cache/${sums[$file]}.new" "$url" || continue
      if [[ $(sha256sum "$cache/${sums[$file]}.new" | cut -d' ' -f1) == "$sha256" ]]; then
        mv "$cache/${sums[$file]}.new" "$cache/${sums[$file]}"
      else
        rm "$cache/${sums[$file]}.new"
      fi
    done

    published=$(one download --target "$kind" | jq -c '.["server-runtime"] // empty')
    if [[ -n $(changed) && -n $published ]]; then
      unpacked=$(mktemp -d -p "$target")
      mapfile -t headers < <(jq -r '.link.headers | to_entries[] | "-H", "\(.key): \(.value)"' <<<"$published")
      curl -fsSL "${headers[@]}" -o "$unpacked.tar.gz" "$(jq -r .link.url <<<"$published")"
      [[ $(sha256sum "$unpacked.tar.gz" | cut -d' ' -f1) == $(jq -r .sha256 <<<"$published") ]] || { echo "The server published for $kind isn't what it should be" >&2 && exit 1; }
      tar -xzf "$unpacked.tar.gz" -C "$unpacked"
      # Where `tooling/release` puts One Core's in a server: beside its code.
      [[ ! -e $unpacked/nifs ]] || while read -r sum file; do
        [[ $file != core/* ]] || { crate=${file#core/server/nif/} && cp "$(echo "$unpacked"/lib/one_core-*/priv/native/"${crate%%/*}".so)" "$cache/$sum.$$" && mv "$cache/$sum.$$" "$cache/$sum"; }
      done <"$unpacked/nifs"
      rm -r "$unpacked" "$unpacked.tar.gz"
    fi

    mac=($(changed))
    ((${#mac[@]})) || continue
    [[ -z $(git status --porcelain) ]] || { echo "Commit what's changed first: GitHub builds the commit." >&2 && exit 1; }
    echo "Building ${mac[*]} on a Mac" >&2
    downloaded=$(mktemp -d -p "$target")
    (tooling/on-mac nifs.yml nifs.tar "$downloaded" \
      'export RUSTUP_TOOLCHAIN=$RUST && env $BUILDS tooling/nifs macos-aarch64 && tar -cf nifs.tar $FILES' \
      -f rust="$(rustc -V | cut -d' ' -f2)" -f builds="${builds[*]}" -f files="${mac[*]}" &&
      tar -xf "$downloaded/nifs.tar" && rm -r "$downloaded") &
    on_github=$!
    continue
  elif [[ $kind != macos-* && $here != Linux ]]; then
    echo "$kind's are built on Linux" >&2 && exit 1
  fi

  built=($(changed))
  ((${#built[@]})) || continue
  # Each kind of machine needs Rust's standard library for it, which a new machine may not have yet.
  rustup target add "$triple" >/dev/null
  env "${builds[@]}" "${wrap[@]}" cargo $build --release $(printf -- '-p %s ' $(basename -a $(dirname "${built[@]}")))
  for file in "${built[@]}"; do
    crate=$(dirname "$file")
    if [[ $crate == */bin/* ]]; then
      program=$target/$triple/release/$(basename "$crate")
      [[ $triple == *windows* ]] && program+=.exe
      cp "$program" "$file"
    else
      cp "$target/$triple/release/$(printf "$library" "$(basename "$crate")")" "$file"
    fi
    keep "$file"
  done
done
if [[ -n ${on_github-} ]]; then
  wait "$on_github" || { echo "${mac[*]} changed since the last build of it, and no Mac built it." >&2 && exit 1; }
  for file in "${mac[@]}"; do keep "$file"; done
fi
