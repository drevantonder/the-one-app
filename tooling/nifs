#!/usr/bin/env bash
# Builds every NIF and program a server needs, One Core's and those of the plugins The One App ships with, for each
# kind of machine a server runs on, or the kinds given, each beside its source: `core/server/nif/<crate>/<kind>.so`,
# which `tooling/release` puts in a server, and as a plugin brings them (`OneCore.Plugin`),
# `plugins/<name>/server/nif/<crate>/<kind>.so` and `plugins/<name>/server/bin/<crate>/<kind>`. A plugin is the same
# files on every server of a network, so it's deployed with all of them:
#
#     tooling/nifs [kind...] && ONE_SUBJECT=network one deploy --name <name> --files-from plugins/<name>
#
# Each kind is built in one place, so every server build of a commit ships the same bytes, and a server finds the
# plugins it ships unchanged: Linux's and Windows' on Linux, Linux's with zig for the same glibc as a server's VM
# (`tooling/release`) and Windows' with cargo-xwin, as a DLL, which is kept under the same kind of name,
# `windows-x86_64.so`; a Mac's on a Mac, with its own toolchain and SDK. From Linux, a Mac's are built on the Mac `ssh
# mac` reaches, in its checkout ~/scratch/one-release, at the same commit, which is on GitHub, so what's built is
# committed. The Mac sleeps, so only one whose inputs changed is built there: one that hasn't is the one built before,
# from this machine's cache or from the latest server published for a Mac, whose `nifs` lists what each of its NIFs
# was built from, as `$target/nifs/<kind>` does for the ones here, which `tooling/release` puts in a server.
#
# Each NIF is named for its build, what it's built from (`tooling/input-hash`), so a server loads a changed one beside
# the one before (`OneCore.Nif`). The Mac is given the names this machine worked out, in NIF_BUILD_<CRATE>, so a
# Mac's NIF is named for what it's kept by here.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
# The tools this needs are the ones `mise.toml` names.
command -v cargo-zigbuild >/dev/null || exec mise exec -C "$root" -- "$0" "$@"
cd "$root"

kinds=("$@")
((${#kinds[@]})) || kinds=(linux-x86_64 linux-aarch64 windows-x86_64 macos-aarch64)
here=$(uname -s)
crates=($(dirname core/server/nif/*/Cargo.toml plugins/*/server/nif/*/Cargo.toml plugins/*/server/bin/*/Cargo.toml))
target=${CARGO_TARGET_DIR:-$root/target}

declare -A sums=()
for kind in "${kinds[@]}"; do
  case $kind in
    linux-x86_64 | linux-aarch64) triple=${kind#*-}-unknown-linux-gnu build="zigbuild --target $triple.2.35" library=lib%s.so ;;
    windows-x86_64) triple=x86_64-pc-windows-msvc build="xwin build --target $triple" library=%s.dll ;;
    macos-aarch64) triple=aarch64-apple-darwin build="build --target $triple" library=lib%s.dylib ;;
    *) echo "No server runs on $kind" >&2 && exit 1 ;;
  esac
  builds=()
  for crate in "${crates[@]}"; do
    [[ $crate == */nif/* ]] || continue
    name=NIF_BUILD_$(basename "$crate" | tr '[:lower:]' '[:upper:]')
    builds+=("$name=${!name:-$(tooling/input-hash "$crate" "$triple")}")
  done

  if [[ $kind == macos-* && $here == Linux ]]; then
    cache=${XDG_CACHE_HOME:-$HOME/.cache}/the-one-app/nifs
    mkdir -p "$cache" "$target/nifs"
    files=()
    for crate in "${crates[@]}"; do
      file=$crate/$kind && [[ $crate == */bin/* ]] || file+=.so
      sums[$file]=$(tooling/input-hash "$crate" "$triple") && files+=("$file")
    done
    for file in "${files[@]}"; do echo "${sums[$file]} $file"; done | sort -k2 >"$target/nifs/$kind"
    changed() { for file in "${files[@]}"; do cp "$cache/${sums[$file]}" "$file" 2>/dev/null || echo "$file"; done; }

    published=$(one download --target "$kind" | jq -c '.server // empty')
    if [[ -n $(changed) && -n $published ]]; then
      unpacked=$(mktemp -d -p "$target")
      mapfile -t headers < <(jq -r '.link.headers | to_entries[] | "-H", "\(.key): \(.value)"' <<<"$published")
      curl -fsSL "${headers[@]}" -o "$unpacked.tar.gz" "$(jq -r .link.url <<<"$published")"
      [[ $(sha256sum "$unpacked.tar.gz" | cut -d' ' -f1) == $(jq -r .sha256 <<<"$published") ]] || { echo "The server published for $kind isn't what it should be" >&2 && exit 1; }
      tar -xzf "$unpacked.tar.gz" -C "$unpacked"
      # Where `tooling/release` puts each in a server: One Core's beside its code, and the plugins' in theirs.
      [[ ! -e $unpacked/nifs ]] || while read -r sum file; do
        case $file in
          core/*) crate=${file#core/server/nif/} && cp "$(echo "$unpacked"/lib/one_core-*/priv/native/"${crate%%/*}".so)" "$cache/$sum" ;;
          plugins/*) cp "$unpacked/bundled/${file#plugins/}" "$cache/$sum" ;;
        esac
      done <"$unpacked/nifs"
      rm -r "$unpacked" "$unpacked.tar.gz"
    fi

    mac=($(changed))
    ((${#mac[@]})) || continue
    [[ -z $(git status --porcelain) ]] || { echo "Commit what's changed first: the Mac builds the commit." >&2 && exit 1; }
    commit=$(git rev-parse HEAD)
    (ssh -o ConnectTimeout=15 mac "zsh -lc 'export PATH=\$HOME/.local/bin:\$PATH && cd ~/scratch/one-release && git fetch -q https://github.com/drevantonder/the-one-app.git $commit && git reset -q --hard $commit && env ${builds[*]} tooling/nifs $kind >&2 && tar -c --no-mac-metadata --no-xattrs ${mac[*]}'" 2> >(sed 's/^/mac: /' >&2) | tar -x) &
    on_mac=$!
    continue
  elif [[ $kind != macos-* && $here != Linux ]]; then
    echo "$kind's are built on Linux" >&2 && exit 1
  fi

  # Each kind of machine needs Rust's standard library for it, which a new machine may not have yet.
  rustup target add "$triple" >/dev/null
  env "${builds[@]}" cargo $build --release $(printf -- '-p %s ' $(basename -a "${crates[@]}"))
  for crate in "${crates[@]}"; do
    if [[ $crate == */bin/* ]]; then
      program=$target/$triple/release/$(basename "$crate")
      cp "$program" "$crate/$kind" 2>/dev/null || cp "$program.exe" "$crate/$kind"
    else
      cp "$target/$triple/release/$(printf "$library" "$(basename "$crate")")" "$crate/$kind.so"
    fi
  done
done
if [[ -n ${on_mac-} ]]; then
  wait "$on_mac" || { echo "${mac[*]} changed since the last build of it, so the Mac builds it, and it didn't: wake the Mac and run this again." >&2 && exit 1; }
  for file in "${mac[@]}"; do cp "$file" "$cache/${sums[$file]}"; done
fi
