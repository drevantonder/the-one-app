#!/usr/bin/env bash
# Builds the NIFs of the plugins The One App ships with for every kind of machine a server runs on, each beside its
# source as a plugin brings it (`OneCore.Plugin`): `plugins/<name>/server/nif/<crate>/<kind>.so`. A plugin is the same
# files on every server of a network, so it's deployed with all of them:
#
#     tooling/nifs && ONE_FOR=network one deploy --name <name> --files-from plugins/<name>
#
# With zig, from one machine, and for Linux for the same glibc as a server's VM (`tooling/release`); for Windows with
# cargo-xwin, as a DLL, which the plugin keeps under the same kind of name, `windows-x86_64.so`.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
# The tools this needs are the ones `mise.toml` names.
command -v cargo-zigbuild >/dev/null || exec mise exec -C "$root" -- "$0" "$@"
cd "$root"

crates=($(dirname plugins/*/server/nif/*/Cargo.toml))
# Each kind of machine needs Rust's standard library for it, which a Mac or a new machine may not have yet.
rustup target add x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu aarch64-apple-darwin x86_64-pc-windows-msvc >/dev/null
target=${CARGO_TARGET_DIR:-$root/target}
for triple in x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu aarch64-apple-darwin x86_64-pc-windows-msvc; do
  case $triple in
    *linux*) os=linux build="zigbuild --target $triple.2.35" library=lib%s.so ;;
    *apple*) os=macos build="zigbuild --target $triple" library=lib%s.dylib ;;
    *windows*) os=windows build="xwin build --target $triple" library=%s.dll ;;
  esac
  cargo $build --release $(printf -- '-p %s ' $(basename -a "${crates[@]}"))
  for crate in "${crates[@]}"; do
    cp "$target/$triple/release/$(printf "$library" "$(basename "$crate")")" "$crate/$os-${triple%%-*}.so"
  done
done
