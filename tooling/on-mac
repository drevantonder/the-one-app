#!/usr/bin/env bash
# Builds something only a Mac builds, at the commit checked out, and puts the file it makes in a folder: on GitHub's
# macOS runner, by its workflow, and on the Mac `ssh mac` reaches, in its checkout ~/scratch/one-release, at once, and
# takes whichever is done first, stopping the other. It says which built it.
#
#     tooling/on-mac <workflow> <file> <folder> '<command>' [-f <input>=<value>]...
#
# The workflow uploads <file> as an artifact of its name without its extension; on the Mac, <command> makes it in
# the checkout, with the same inputs in its environment, named in capitals (`-f rust=1.99.1` is RUST). GitHub's
# runner leaves the Mac alone, but at times it has no macOS runner for hours, out of capacity, and takes 4 to 5
# minutes when it has one (18 Nov: half the runs had none within 5 minutes, which were then waited for before the Mac
# began); the Mac's checkout builds only what changed, in a minute or two, in the background there, as its person may
# be using it, one build at a time, as they share its checkout. One that's asleep or away leaves it to GitHub.
set -euo pipefail

workflow=$1 file=$2 folder=$3 command=$4 && shift 4
commit=$(git rev-parse HEAD)
inputs=() env=()
for arg in "$@"; do
  [[ $arg == -f ]] && continue
  inputs+=(-f "$arg") && env+=("$(tr a-z A-Z <<<"${arg%%=*}")=$(printf %q "${arg#*=}")")
done

run=$(gh workflow run "$workflow" --ref main -f commit="$commit" "${inputs[@]}" 2>&1 | grep -o 'https://github.com/.*/actions/runs/[0-9]*') ||
  { echo "GitHub wasn't asked to run $workflow." >&2 && exit 1; }
id=${run##*/}

# Waits until the run is completed, or until `$1` seconds into this. `gh run watch` ends at the first of GitHub's API
# calls that fails, as some do while many releases watch at once (after 3 s, 18 Nov), so a watch that ends early is
# started again, after the 30 s GitHub asks a client to wait.
wait_for() {
  local left
  while true; do
    left=$(($1 - SECONDS))
    [[ $(gh run view "$id" --json status --jq .status 2>/dev/null) == completed ]] || ((left <= 0)) && return
    timeout "$left" gh run watch "$id" --interval 30 >/dev/null 2>&1 || (($? == 124)) || sleep 30
  done
}
# Each puts what it built in a folder of its own, and the first that's done wins.
mkdir -p "$folder/.github" "$folder/.mac"
github() {
  wait_for $((SECONDS + 6 * 3600))
  [[ $(gh run view "$id" --json conclusion --jq .conclusion) == success ]] ||
    { echo "$workflow failed on GitHub: gh run view $id --log-failed" >&2 && return 1; }
  gh run download "$id" -n "${file%.*}" -D "$folder/.github"
}
mac() {
  ssh -o ConnectTimeout=15 mac "zsh -lc $(printf %q "set -e; export PATH=\$HOME/.local/bin:\$HOME/.cargo/bin:\$PATH CARGO_BUILD_JOBS=4 ${env[*]}
lockf -k ~/scratch/one-release.lock bash -c $(printf %q "cd ~/scratch/one-release && git fetch -q https://github.com/ptc-au/the-one-app.git $commit && git reset -q --hard $commit &&
nice -n 19 taskpolicy -d throttle bash -c $(printf %q "$command") >&2 && cat $file && rm $file")")" >"$folder/.mac/$file"
}
github &
on_github=$!
mac &
on_mac=$!
# One that failed is reaped, and waited on again it's `no such job`, so the second wait is for the other alone.
winner=
pending=("$on_github" "$on_mac")
while ((${#pending[@]})); do
  if wait -n -p done "${pending[@]}"; then winner=$done && break; fi
  echo "$([[ $done == "$on_github" ]] && echo "GitHub" || echo "The Mac") didn't build $file" >&2
  for at in "${!pending[@]}"; do [[ ${pending[at]} == "$done" ]] && unset "pending[$at]"; done
  pending=("${pending[@]}")
done
if [[ $winner == "$on_github" ]]; then
  kill "$on_mac" 2>/dev/null || true
  mv "$folder/.github/$file" "$folder/$file"
  echo "$file was built on GitHub's macOS runner, in ${SECONDS}s: $run" >&2
elif [[ -n $winner ]]; then
  kill "$on_github" 2>/dev/null || true
  gh run cancel "$id" >/dev/null 2>&1 || true
  mv "$folder/.mac/$file" "$folder/$file"
  echo "$file was built on the Mac, in ${SECONDS}s" >&2
fi
rm -rf "$folder/.github" "$folder/.mac"
[[ -n $winner ]]
