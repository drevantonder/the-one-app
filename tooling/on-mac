#!/usr/bin/env bash
# Builds something only a Mac builds, at the commit checked out, and puts the file it makes in a folder: on GitHub's
# macOS runner, by its workflow, or on the Mac `ssh mac` reaches, in its checkout ~/scratch/one-release. It says
# which built it.
#
#     tooling/on-mac <workflow> <file> <folder> '<command>' [-f <input>=<value>]...
#
# The workflow uploads <file> as an artifact of its name without its extension; on the Mac, <command> makes it in
# the checkout, with the same inputs in its environment, named in capitals (`-f rust=1.99.1` is RUST). GitHub's
# runner is free and leaves the Mac alone, but at times it has no macOS runner for hours, out of capacity (18 Nov), and
# drops a job after 15 minutes: a job no runner has taken within 5 is cancelled, and the Mac builds it, slowly and in
# the background there, as its person may be using it.
set -euo pipefail

workflow=$1 file=$2 folder=$3 command=$4 && shift 4
commit=$(git rev-parse HEAD)
inputs=() env=()
for arg in "$@"; do
  [[ $arg == -f ]] && continue
  inputs+=(-f "$arg") && env+=("$(tr a-z A-Z <<<"${arg%%=*}")=$(printf %q "${arg#*=}")")
done

run=$(gh workflow run "$workflow" --ref main -f commit="$commit" "${inputs[@]}" 2>&1 | grep -o 'https://github.com/.*/actions/runs/[0-9]*') ||
  { echo "GitHub wasn't asked to run $workflow." >&2 && exit 1; }
id=${run##*/}
if timeout 300 gh run watch "$id" >/dev/null 2>&1 || [[ $(gh run view "$id" --json jobs --jq '[.jobs[].steps | length] | add // 0') != 0 ]]; then
  gh run watch "$id" --exit-status >/dev/null 2>&1 || { echo "$workflow failed on GitHub: gh run view $id --log-failed" >&2 && exit 1; }
  gh run download "$id" -n "${file%.*}" -D "$folder"
  echo "$file was built on GitHub's macOS runner: $run" >&2
  exit
fi
gh run cancel "$id" >/dev/null 2>&1 || true
echo "GitHub had no macOS runner for $workflow in 5 minutes ($run), so the Mac builds $file" >&2
ssh -o ConnectTimeout=15 mac "zsh -lc $(printf %q "set -e; export PATH=\$HOME/.local/bin:\$HOME/.cargo/bin:\$PATH CARGO_BUILD_JOBS=4 ${env[*]}
cd ~/scratch/one-release && git fetch -q https://github.com/drevantonder/the-one-app.git $commit && git reset -q --hard $commit
nice -n 19 taskpolicy -d throttle bash -c $(printf %q "$command") >&2 && cat $file && rm $file")" >"$folder/$file.part"
mv "$folder/$file.part" "$folder/$file"
echo "$file was built on the Mac" >&2
