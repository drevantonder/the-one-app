#!/usr/bin/env bash
# Builds server and client builds from the commit checked out, which is on main, and publishes them to a network.
# Its servers take them by themselves, as the network's update (`core/edge/updater/updater.ts`) says, and a device
# with `one update`. Publishing is all this does:
#
#     tooling/release [server] [client] [--dry-run]
#     tooling/release <name>...
#
# `server` is a server for every kind of machine one of the network's servers runs on, and `client` is `one` for
# every kind of desktop machine among the network's devices; neither says both. A name is one build, as
# `one builds` names them: `server/linux-x86_64`, `one/macos-aarch64`, `one-cli/linux-x86_64`. A phone's app is
# built by the network's owner from its repo (`iphone` skill), not here, and Windows has `one-cli` only, until the app
# has a Windows build. --dry-run says what it would build, and builds nothing.
#
# The network is the one of the client this machine's `one` is, or the one in ONE_HOME. Whoever it is needs to be
# the network's owner. Linux builds every server, from one set of NIFs (`tooling/nifs`), so each ships its apps as
# the same files, and Linux's `one` and Windows', with the MSVC toolchain cargo-xwin downloads. A Mac builds a Mac's
# `one`, which needs its system's frameworks: from Linux, it's built on the Mac `ssh mac` reaches, in its checkout
# ~/scratch/one-release, at the same commit. A server release and a client release run at once, each in a checkout of its own, but a second of
# the same kind is refused while the first builds. One published while the network's update of the one before is under
# way takes its place there. A commit older than one
# the network has published is refused, so a release that finishes late doesn't undo a newer one. A build already
# published is left as it is, and published again, so a network that didn't hear of it does.
#
# A server is an Erlang release of One Core (`core/server/mix.exs`) that needs nothing else on its machine: the VM
# and OTP as Hex builds them for each kind of machine (Ubuntu 22.04's, so glibc 2.35 and OpenSSL 3 or newer), or as
# Erlang/OTP builds them for Windows, with the Visual C++ runtime they need beside them, from the installer that comes
# with them, One Core's Rust NIFs built for that machine (by `tooling/nifs`), and the UI library's build, and the Bun it
# builds apps with named by its SHA-256, which it downloads the first time (`OneCore.Entrypoint`). The builds are in
# target/builds/<build> of the checkout it builds in, on Linux ~/.cache/the-one-app/release.
#
# A server for a kind of machine, `server/<kind>`, is published in two parts, which a machine puts together (`one
# serve run`): `server-code`, One Core's own code, its release's `releases/` and the UI library, the same for every kind of
# machine, and `server-runtime/<kind>`, the rest. A runtime is told by the SHA-256 of what it's built from, which the
# network keeps with it as its `inputs`, and published only when that changed, under the build that first had it,
# which its file `runtime` names. It's what it's built from, not its files, since those name the folders they were
# built in.
# A machine loads new code and NIFs into its server while it runs, unless the rest of its runtime changed
# (`OneCore.Release.compare/2`).
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
# The tools this needs are the ones `mise.toml` names.
command -v mix >/dev/null || exec mise exec -C "$root" -- "$0" "$@"
cd "$root"

usage="tooling/release [server] [client] [--dry-run], or tooling/release <name>..."
dry= wanted=()
for arg in "$@"; do
  case $arg in
    --dry-run) dry=yes ;;
    server | client | server/* | one/* | one-cli/*) wanted+=("$arg") ;;
    *) echo "$usage" >&2 && exit 1 ;;
  esac
done
((${#wanted[@]})) || wanted=(server client)

# Servers and clients share nothing but the network they publish to, so each is its own release, with its own lock and
# checkout (below), and one that asks for both runs the two at once.
want_servers=() want_clients=()
for want in "${wanted[@]}"; do
  case $want in server | server/*) want_servers+=("$want") ;; *) want_clients+=("$want") ;; esac
done
if ((${#want_servers[@]} && ${#want_clients[@]})); then
  "$0" ${dry:+--dry-run} "${want_servers[@]}" > >(sed 's/^/server: /') 2>&1 &
  server=$!
  "$0" ${dry:+--dry-run} "${want_clients[@]}" > >(sed 's/^/client: /') 2>&1 &
  client=$!
  status=0
  wait "$server" || status=1
  wait "$client" || status=1
  exit $status
fi
kind=server
((${#want_servers[@]})) || kind=client

# Each line says how many seconds into the release it is, so where a release's time goes is in what it printed. The
# Mac's lines come through Linux's.
[[ $(uname) != Linux ]] || exec > >(while IFS= read -r line; do printf '%4ds %s\n' "$SECONDS" "$line"; done) 2>&1

# A build is named by its commit's version (`tooling/version`), so what's built is all committed.
[[ -z $(git status --porcelain) ]] || { echo "Commit what's changed first: a build is named by its commit." >&2 && exit 1; }
build=$(tooling/version)
commit=$(git rev-parse HEAD)
here="$(uname -s | sed -e s/Linux/linux/ -e s/Darwin/macos/)-$(uname -m | sed s/arm64/aarch64/)"
builds=$(one builds)

# What's asked for, by name. A desktop or the CLI is built for each kind of machine a device of the network's is,
# but a phone, whose app the network's owner builds.
names=()
for want in "${wanted[@]}"; do
  case $want in
    server) names+=($(jq -r '.servers[].target | "server/" + .' <<<"$builds")) ;;
    client) names+=($(jq -r '.devices[].target | select(startswith("linux-")) | "one/" + ., "one-cli/" + .' <<<"$builds")
      $(jq -r '.devices[].target | select(startswith("macos-")) | "one/" + .' <<<"$builds")
      $(jq -r '.devices[].target | select(startswith("windows-")) | "one-cli/" + .' <<<"$builds")) ;;
    *) names+=("$want") ;;
  esac
done
names=($(printf '%s\n' "${names[@]}" | sort -u))

# Nothing older than what the network runs or has published: a release that finished late would undo it.
for running in $(jq -r '[.servers[].build, .devices[].build, (.latest // {} | .[].build)] | unique[]' <<<"$builds"); do
  sha=${running##*[-.]}
  if [[ $commit != "$sha"* ]] && git cat-file -e "$sha^{commit}" 2>/dev/null && git merge-base --is-ancestor "$commit" "$sha"; then
    echo "The network has $running already, which is newer than $build: release from main as it is now." >&2 && exit 1
  fi
done
# A breaking release only once every server and the edge are on the one before, since parts two apart don't talk
# (`OneCore.Builds.talk?/2`). Devices aren't waited for: their people update them, which works whatever they're on.
behind=$(jq -r --arg build "$build" '
  def series: (split(".") | map(tonumber? // 0)) as [$major, $minor] | if $major == 0 then "0.\($minor)" else "\($major)" end;
  select(.network.build)
  | (.network.build | series) as $now
  | select(($build | series) != $now)
  | [(.servers[] | select((.build // "0.15.0" | series) != $now) | "\(.name) on \(.build)"),
     (select((.edge // "0.15.0" | series) != $now) | "the edge on \(.edge)")]
  | join(", ")' <<<"$builds")
[[ -z $behind ]] || { echo "$build is a breaking release, and $behind isn't on the network's $(jq -r .network.build <<<"$builds") yet: release it once they are." >&2 && exit 1; }


# Which are built here, which on the Mac, and which are published already.
mine=() mac=()
for name in "${names[@]}"; do
  kind=${name#*/}
  # A server is published as its code, which is the same for every kind, and its kind's runtime, which a kind of
  # machine new to the network has none of yet.
  if [[ $(jq -r --arg n "${name/#server\/*/server-code}" '.latest[$n].build // ""' <<<"$builds") == "$build" ]] &&
    { [[ $name != server/* ]] || jq -e --arg n "server-runtime/$kind" '.latest[$n]' <<<"$builds" >/dev/null; }; then
    echo "$name  $build is published already"
  elif [[ $name == server/* && $here != linux-* ]]; then
    echo "$name is built on Linux: build it there with tooling/release $name" >&2 && exit 1
  elif [[ $name == server/* || $kind == "$here" || ($here == linux-* && $kind == windows-*) ]]; then
    mine+=("$name")
  elif [[ $here == linux-* && $kind == macos-* ]]; then
    mac+=("$name")
  else
    echo "$name isn't built on $here: build it on such a machine with tooling/release $name" >&2 && exit 1
  fi
done
for name in "${mine[@]}"; do echo "$name  $build, built here"; done
for name in "${mac[@]}"; do echo "$name  $build, built on the Mac"; done
[[ -z $dry ]] || exit 0
# Published already: published again, which sends nothing, so a network that didn't hear of it does.
((${#mine[@]} + ${#mac[@]})) || { one publish --builds '[]' >/dev/null && exit; }

# One server release and one client release on a machine at a time, each kept as a pid file rather than flock: a daemon
# a build starts (epmd, a compiler cache) inherits a flock's descriptor and outlives the release, which then refused
# the next one with nothing publishing. Each holds its own checkout (below), which is what a second of its kind can't
# share; a server's and a client's don't touch, so they build at once. What a Mac builds is asked for by Linux's
# release, so the client's lock covers it.
if [[ $(uname) == Linux ]]; then
  lock=${XDG_RUNTIME_DIR:-/tmp}/one-release-$kind.pid
  if ! (set -o noclobber && echo "$$ $build" >"$lock") 2>/dev/null; then
    read -r pid was <"$lock" || true
    if kill -0 "$pid" 2>/dev/null; then
      echo "The $kind release of $was is building on this machine (pid $pid): let it finish rather than build over it." >&2
      exit 1
    fi
    echo "$$ $build" >"$lock"
  fi
  trap 'rm -f "$lock"' EXIT

  # It builds in one checkout kept for releasing each kind on this machine, put at the commit released, so each release
  # builds, downloads and installs only what changed since the one before, as the Mac's ~/scratch/one-release does,
  # rather than all of it again in each new worktree (most of a server's build, 17 Nov).
  kept=${XDG_CACHE_HOME:-$HOME/.cache}/the-one-app/release-$kind
  [[ -d $kept ]] || { git worktree prune && git worktree add -q --detach "$kept" "$commit"; }
  git -C "$kept" checkout -q --detach -f "$commit"
  root=$kept && cd "$root"
fi

servers=($(printf '%s\n' "${mine[@]}" | sed -n 's|^server/||p'))

# The Mac builds its part from the same commit meanwhile, once it's built its NIFs in the same checkout.
if ((${#mac[@]})); then
  ssh mac "zsh -lc 'export PATH=\$HOME/.local/bin:\$PATH && cd ~/scratch/one-release && git fetch -q https://github.com/drevantonder/the-one-app.git $commit && git reset -q --hard $commit && tooling/release ${mac[*]}'" > >(sed 's/^/mac: /') 2>&1 &
  on_mac=$!
fi

# `one`, which is the app too, and on Linux `one-cli`, the same without its window, for a machine with no screen,
# which has no GTK or WebKitGTK; `one update` keeps each on its own. Building it for another kind of machine needs
# that machine's system libraries, so each kind builds its own. Each builds at once, beside the servers, in a target
# folder of its own: cargo holds one folder for one build at a time.
target=${CARGO_TARGET_DIR:-$root/target}
out=$target/builds/$build
rm -rf "$out" && mkdir -p "$out"
clients=()
for name in "${mine[@]}"; do
  file=$(tr / - <<<"$name")
  case $name in
    one-cli/windows-*) cargo=(xwin build --target x86_64-pc-windows-msvc --no-default-features) program=x86_64-pc-windows-msvc/release/one.exe ;;
    one-cli/*) cargo=(build --no-default-features) program=release/one ;;
    one/*) cargo=(build) program=release/one ;;
    *) continue ;;
  esac
  (echo "Building $name" && CARGO_TARGET_DIR=$target/clients/$file cargo "${cargo[@]}" --release -p app &&
    gzip -9 -c "$target/clients/$file/$program" >"$out/$file.gz") &
  clients+=($!)
done

cache=$target/release-cache
mkdir -p "$cache"

# Downloads a file once, into the cache, checked against its SHA-256.
fetched() {
  local file=$cache/$2
  [[ -e $file ]] || { curl -fsSL -o "$file.part" "$1" && mv "$file.part" "$file"; }
  [[ $(sha256sum "$file" | cut -d' ' -f1) == "$3" ]] || { echo "$1 isn't what it should be" >&2 && rm "$file" && exit 1; }
  echo "$file"
}

if ((${#servers[@]})); then
  # The servers' NIFs, for the kinds of machine they're built for, and the UI library, each while the rest gets ready.
  tooling/nifs "${servers[@]}" &
  nifs=$!
  (cd core/ui && bun install --frozen-lockfile >/dev/null && bun build.js >/dev/null) &
  ui=$!
  otp=$(erl -noshell -eval '{ok, V} = file:read_file(filename:join([code:root_dir(), "releases", erlang:system_info(otp_release), "OTP_VERSION"])), io:put_chars(string:trim(V)), halt().')
  bun=$(bun --version)
  # What strips the VM's debugging symbols, for any kind of machine: Rust's own LLVM tools.
  objcopy=$(rustc --print sysroot)/lib/rustlib/$(rustc -vV | sed -n 's/^host: //p')/bin/llvm-objcopy
  [[ -x $objcopy ]] || rustup component add llvm-tools
  (cd core/server && mix deps.get --only prod >/dev/null)
  bun_sums=$(curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v$bun/SHASUMS256.txt")
  wait "$nifs" || { echo "The servers' NIFs weren't built." >&2 && exit 1; }
  wait "$ui" || { echo "The UI library wasn't built." >&2 && exit 1; }
fi

packing=() code=()
for kind in "${servers[@]}"; do
  echo "Building the server for $kind"
  case $kind in
    linux-x86_64) hex=amd64 bunzip=bun-linux-x64-baseline.zip triple=x86_64-unknown-linux-gnu ;;
    linux-aarch64) hex=arm64 bunzip=bun-linux-aarch64.zip triple=aarch64-unknown-linux-gnu ;;
    macos-aarch64) bunzip=bun-darwin-aarch64.zip triple=aarch64-apple-darwin ;;
    windows-x86_64) bunzip=bun-windows-x64-baseline.zip triple=x86_64-pc-windows-msvc ;;
    *) echo "There's no server for $kind" >&2 && exit 1 ;;
  esac

  # The VM and OTP for that machine, from Hex's builds for Linux, Erlang/OTP's own for Windows and the Erlang
  # Ecosystem Foundation's for a Mac, fetched once.
  vm=$cache/otp-$otp-$kind
  if [[ ! -d $vm ]]; then
    if [[ $kind == linux-* ]]; then
      sum=$(curl -fsSL "https://builds.hex.pm/builds/otp/$hex/ubuntu-22.04/builds.txt" | awk -v v="OTP-$otp" '$1 == v { print $4 }')
      archive=$(fetched "https://builds.hex.pm/builds/otp/$hex/ubuntu-22.04/OTP-$otp.tar.gz" "otp-$otp-$kind.tar.gz" "$sum")
    elif [[ $kind == windows-* ]]; then
      zip=otp_win64_$otp.zip
      sum=$(curl -fsSL "https://api.github.com/repos/erlang/otp/releases/tags/OTP-$otp" | jq -r --arg z "$zip" '.assets[] | select(.name == $z) | .digest | ltrimstr("sha256:")')
      archive=$(fetched "https://github.com/erlang/otp/releases/download/OTP-$otp/$zip" "otp-$otp-$kind.zip" "$sum")
    else
      url="https://github.com/erlef/otp_builds/releases/download/OTP-$otp/otp-aarch64-apple-darwin.tar.gz"
      [[ -e $cache/otp-$otp-$kind.tar.gz ]] || curl -fsSL -o "$cache/otp-$otp-$kind.tar.gz" "$url"
      archive=$cache/otp-$otp-$kind.tar.gz
    fi
    rm -rf "$vm.part" && mkdir -p "$vm.part"
    if [[ $kind == windows-* ]]; then
      unzip -q "$archive" -d "$vm.part" -x 'doc/*' '*.pdb' '*/doc/*' '*/src/*' '*/examples/*' '*/beam.debug.smp.dll'
      # The VM needs the Visual C++ runtime, which a PC may not have: its DLLs go beside it, as Microsoft lets an
      # app carry them, from the installer of it that comes with Erlang/OTP.
      (cd "$vm.part" && 7z x -t# -y -ovc_redist vc_redist.exe >/dev/null && 7z x -y -ovc_redist/cabs vc_redist/4.cab >/dev/null &&
        cab=$(grep -l vcruntime140.dll_amd64 vc_redist/cabs/*) &&
        for dll in vcruntime140 vcruntime140_1 msvcp140; do 7z e -y -so "$cab" "$dll.dll_amd64" >"$(echo erts-*)/bin/$dll.dll"; done &&
        rm -r vc_redist vc_redist.exe)
    else
      tar -xzf "$archive" -C "$vm.part" --strip-components=1
    fi
    mv "$vm.part" "$vm"
  fi
  # Hex's builds are made whole where they're put by their own script.
  [[ ! -x $vm/Install || -e $vm/bin/erl ]] || (cd "$vm" && ./Install -minimal "$vm" >/dev/null)

  release=$target/release-builds/$kind
  rm -rf "$release"
  (cd core/server && MIX_ENV=prod ONE_ERTS=$(echo "$vm"/erts-*) mix release --overwrite --quiet --path "$release")
  # The NIFs of OTP's own applications as they're built for that machine. Their code runs on any.
  for app in "$release"/lib/*; do
    [[ ! -d $vm/lib/$(basename "$app")/priv ]] || { rm -rf "$app/priv" && cp -R "$vm/lib/$(basename "$app")/priv" "$app/priv"; }
  done
  priv=$(echo "$release"/lib/one_core-*)/priv/native
  rm -rf "$priv" && mkdir -p "$priv"
  for nif in core/server/nif/*/$kind.so; do
    # The VM loads a NIF by its name without its extension, which on Windows is a DLL's.
    crate=$(basename "$(dirname "$nif")")
    if [[ $kind == windows-* ]]; then cp "$nif" "$priv/$crate.dll"; else cp "$nif" "$priv/$crate.so"; fi
  done
  # Windows' VM keeps its debugging symbols apart already.
  [[ $kind == windows-* ]] || "$objcopy" --strip-all "$(echo "$release"/erts-*/bin/beam.smp)"

  # What it ships with: the UI library's build, which it builds apps against and serves, and the Bun it builds apps
  # with. What its NIFs were built from is beside them, for `tooling/nifs` to find a Mac's again.
  [[ ! -e $target/nifs/$kind ]] || cp "$target/nifs/$kind" "$release/nifs"
  cp -R core/ui/dist "$release/ui"
  echo "https://github.com/oven-sh/bun/releases/download/bun-v$bun/$bunzip $(awk -v z="$bunzip" '$2 == z { print $1 }' <<<"$bun_sums")" >"$release/bun"

  # The runtime is everything but One Core's own code. What it's built from says which it is: the one published, if
  # that's the same, and otherwise a new one, this build's. That's the VM, Elixir and Bun, the deps, One Core's config
  # and release settings and this loop, which puts them together, kept in the runtime's file `runtime-inputs`, which a
  # server on another runtime restarts for (`OneCore.Release.compare/2`); and One Core's NIFs, as each is named for
  # what it's built from (`tooling/input-hash`), which a running server loads beside the ones it has.
  runtime_inputs=$({
    echo "$kind $otp $(elixir --version | tail -1)" && cat "$release/bun" &&
      (cd core/server && sha256sum mix.exs mix.lock config/* rel/*) &&
      sed -n '/^for kind in "${servers\[@\]}"; do$/,/^done$/p' tooling/release
  } | sha256sum | cut -d' ' -f1)
  echo "$runtime_inputs" >"$release/runtime-inputs"
  inputs=$({
    echo "$runtime_inputs" && for crate in core/server/nif/*/; do tooling/input-hash "$crate" "$triple"; done
  } | sha256sum | cut -d' ' -f1)
  runtime=$(jq -r --arg n "server-runtime/$kind" --arg i "$inputs" '.latest[$n] | select(.inputs == $i) | .build' <<<"$builds")
  echo "${runtime:-$build}" >"$release/runtime"
  if [[ -z $runtime ]]; then
    echo "$inputs" >"$out/server-runtime-$kind.inputs"
    (cd "$release" && find . -type f ! -path './releases/*' ! -path './ui/*' \
      \( ! -path './lib/one_core-*' -o -path './lib/one_core-*/priv/native/*' \) -print0 |
      tar -czf "$out/server-runtime-$kind.tar.gz" --null --no-recursion -T -) &
    packing+=($!)
  fi
  # One Core's own code is the same for every kind, so it's packed from the first.
  ((${#code[@]})) || {
    tar -czf "$out/server-code.tar.gz" -C "$release" --exclude='./lib/one_core-*/priv/native' ./releases ./ui $(cd "$release" && echo ./lib/one_core-*) &
    code=($!) && packing+=($!)
  }
done
# Each is packed while the next kind builds.
for pack in "${packing[@]}"; do wait "$pack" || { echo "A server wasn't packed." >&2 && exit 1; }; done

for client in "${clients[@]}"; do wait "$client" || { echo "A client wasn't built." >&2 && exit 1; }; done

# Publishes what was built: the network gives a link for each file it doesn't have yet, which is sent there, and
# once it has them all, they're the latest.
if ((${#mine[@]})); then
  echo "Publishing to the network"
  ONE=$(command -v one) OUT=$out BUILD=$build bun -e '
    const { ONE, OUT, BUILD } = process.env;
    const { readdirSync } = require("node:fs");
    const builds = await Promise.all(readdirSync(OUT).filter((file) => file.endsWith(".gz")).map(async (file) => {
      const bytes = await Bun.file(`${OUT}/${file}`).bytes();
      const [, what, kind] = file.match(/^(server-runtime|server-code|server|one-cli|one)-?(.*?)(\.tar)?\.gz$/);
      // A runtime is told by what it was built from, which the network keeps with it.
      const inputs = what === "server-runtime" ? { inputs: (await Bun.file(`${OUT}/${file.replace(/\.tar\.gz$/, ".inputs")}`).text()).trim() } : {};
      return { file, name: kind ? `${what}/${kind}` : what, build: BUILD, ...inputs, sha256: new Bun.CryptoHasher("sha256").update(bytes).digest("hex"), size: bytes.length };
    }));
    const publish = () => {
      const published = Bun.spawnSync([ONE, "publish", "--builds", JSON.stringify(builds.map(({ file, ...build }) => build))], { stderr: "inherit" });
      if (published.exitCode !== 0) process.exit(1);
      return JSON.parse(published.stdout.toString());
    };
    let published = publish();
    if (published.send) {
      await Promise.all(builds.filter(({ name }) => published.send[name]).map(async ({ file, name }) => {
        const { method, url, headers } = published.send[name];
        const sent = await fetch(url, { method, headers, body: Bun.file(`${OUT}/${file}`) });
        if (!sent.ok) throw new Error(`${name} wasn'"'"'t sent: ${sent.status}`);
      }));
      published = publish();
    }
    if (published.send) throw new Error("The network didn'"'"'t take them");
    for (const { name, size } of builds) console.log(`${name}  ${BUILD}  ${(size / 1e6).toFixed(1)} MB`);
  '
fi
[[ -z ${on_mac-} ]] || wait "$on_mac" || { echo "The Mac's part wasn't released." >&2 && exit 1; }
echo "The network's servers take $build by themselves (\`one builds\` says how far), and a device with \`one update\`."
