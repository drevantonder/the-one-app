#!/usr/bin/env bash
# Builds server and client builds from the commit checked out, which is on main, and publishes them as the core's
# release, which every network takes them from (`publish`): its servers by themselves, as its update
# (`core/edge/updater/updater.ts`) says, and a device
# with `one update`. Publishing is all this does:
#
#     tooling/release [server] [client] [--dry-run]
#     tooling/release <name>...
#
# `server` is a server for every kind of machine one of the network's servers runs on, and `client` is `one` for
# every kind of desktop machine among the network's devices; neither says both. A name is one build, as
# `one builds` names them: `server/linux-x86_64`, `one/macos-aarch64`, `one-cli/linux-x86_64`. A phone's app is
# built by the network's owner from its repo (`iphone` skill), not here. Windows' app, `one/windows-x86_64`, comes
# with its installer, `one-setup/windows-x86_64`, which a person installs it with the first time (`clients/app/
# installer.nsi`); from then on it updates itself, as on Linux and a Mac. --dry-run says what it would build, and
# builds nothing.
#
# What's built is what the network of the client this machine's `one` is, or the one in ONE_HOME, runs, and what it
# says is latest, which is the core's release's. Linux builds every server, from one set of NIFs (`tooling/nifs`), so each ships its apps as
# the same files, and Linux's `one` and Windows', with the MSVC toolchain cargo-xwin downloads. A Mac's `one` needs
# its system's frameworks: from Linux, it's built on a Mac (`tooling/on-mac`: GitHub's runner, or the owner's), from
# the same commit with the same Rust, and published with the rest. A server release and a client release run at once,
# each in a checkout of its own, and one that asks for both publishes what both built as one update; a second of the
# same kind waits for the first. One published while the network's
# update of the one before is under way takes its place there. A build the network has published from this commit, or
# from a newer one, which has this one's changes, covers it: it's left as it is, so a release that finishes late
# doesn't undo a newer one, and one of this commit is published again, so a network that didn't hear of it does. That's
# the first thing a release looks at, and a release waiting for another looks again as it waits, and ends at once, with
# the exit status 0, when the one it waits for is of a commit that has its changes, saying which to follow with `one
# builds`: only a release whose commit nothing covers waits to publish. So is a client built from
# the same as the network's latest: it keeps its build, which `one --version` says, rather than being built again for
# a version it wouldn't differ in. A client's `inputs` are what
# `client_inputs` says, kept with it as a runtime's are.
#
# A server is an Erlang release of One Core (`core/server/mix.exs`) that needs nothing else on its machine: the VM
# and OTP as Hex builds them for each kind of machine (Ubuntu 22.04's, so glibc 2.35 and OpenSSL 3 or newer), or as
# Erlang/OTP builds them for Windows, with the Visual C++ runtime they need beside them, from the installer that comes
# with them, One Core's Rust NIFs built for that machine (by `tooling/nifs`), and the UI library's build, and the Bun it
# builds apps with, and on Windows Git, named by their SHA-256, which it downloads the first time (`OneCore.Programs`).
# A Mac's VM is signed on the Mac, which must be awake. The builds are in
# target/builds/<build> of the checkout it builds in, on Linux ~/.cache/the-one-app/release-<server or client>.
#
# A server for a kind of machine, `server/<kind>`, is published in two parts, which a machine puts together (`one
# serve run`): `server-code`, One Core's own code, its release's `releases/` and the UI library, the same for every kind of
# machine, and `server-runtime/<kind>`, the rest. A runtime is told by the SHA-256 of what it's built from, which the
# network keeps with it as its `inputs`, and published only when that changed, under the build that first had it,
# which its file `runtime` names. It's what it's built from, not its files, since those name the folders they were
# built in.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
# The tools this needs are the ones `mise.toml` names.
command -v mix >/dev/null || exec mise exec -C "$root" -- "$0" "$@"
cd "$root"

usage="tooling/release [server] [client] [--dry-run], or tooling/release <name>..."
dry= wanted=()
for arg in "$@"; do
  case $arg in
    --dry-run) dry=yes ;;
    server | client | server/* | one/* | one-cli/*) wanted+=("$arg") ;;
    *) echo "$usage" >&2 && exit 1 ;;
  esac
done
((${#wanted[@]})) || wanted=(server client)

# Every build is published with the platform's Ed25519 signature of its name, build and SHA-256, by BUILD_SIGNING_KEY,
# a PKCS#8 DER in base64 (in 1Password, "The One App build signing key"), whose public half, `key`, is built into `one`,
# which takes no build without it (`clients/cli/src/serving.rs`), as Tauri's updater and Sparkle take theirs.
key=3fd5f3516020dafc3690044ac56dceef578b1f162b72ec4687af2d764192d2f2
# The core's own release, which every network takes its builds from (`publish`).
repo=ptc-au/the-one-app tag=builds
# Without BUILD_SIGNING_KEY in the environment (an override, for a machine without 1Password) it's read from 1Password,
# into this process only.
[[ -n $dry || -n ${BUILD_SIGNING_KEY:-} ]] ||
  BUILD_SIGNING_KEY=$(op read "op://van-tonder-nosudo/The One App build signing key/credential") || exit 1
export BUILD_SIGNING_KEY
[[ -n $dry ]] || [[ $(base64 -d <<<"${BUILD_SIGNING_KEY:-}" 2>/dev/null | openssl pkey -inform DER -pubout -outform DER 2>/dev/null |
  tail -c 32 | xxd -p -c 64) == "$key" ]] || { echo "BUILD_SIGNING_KEY isn't the platform's build signing key." >&2 && exit 1; }

# Publishes the builds in each of the folders given as the core's release, `builds` on GitHub, which every network
# takes its builds from (`OneCore.Builds`), its edge telling its updater within five minutes (`core/edge/updater/core.ts`),
# and a new network's first server is installed from (`one serve on --first`): each file by its SHA-256, and for each
# kind of machine, `<target>.json`, the latest of each name for it, `server-code` in every one, with its link there.
# A `one` keeps `serving`, the build that first had what a server runs of it (`serves`), so one that changed only the
# app around `one serve run` restarts no server. The builds before stay, as a machine may be downloading one as the
# next is published, and what neither the lists before nor now name goes.
publish() {
  echo "Publishing to the core's release, $repo $tag"
  gh release view "$tag" -R "$repo" >/dev/null 2>&1 ||
    gh release create "$tag" -R "$repo" --latest=false --title "The latest builds" \
      --notes "What every network's servers and devices take, and a new network's first server is installed from: \`one serve on --address <address> --first <secret> --owner <name>\` (core/edge/README.md)." >/dev/null
  REPO=$repo TAG=$tag BUILD=$build bun -e '
    const { REPO, TAG, BUILD, BUILD_SIGNING_KEY } = process.env;
    const { readdirSync, mkdtempSync, copyFileSync, writeFileSync, rmSync } = require("node:fs");
    const { tmpdir } = require("node:os");
    const { createPrivateKey, sign } = require("node:crypto");
    const gh = (...args) => {
      const ran = Bun.spawnSync(["gh", ...args, "-R", REPO], { stderr: "inherit" });
      if (ran.exitCode !== 0) throw new Error(`gh ${args.slice(0, 2).join(" ")} failed`);
      return ran.stdout.toString();
    };
    const key = createPrivateKey({ key: Buffer.from(BUILD_SIGNING_KEY, "base64"), format: "der", type: "pkcs8" });
    const files = process.argv.slice(1).flatMap((out) => readdirSync(out).filter((file) => /\.(gz|exe)$/.test(file)).map((file) => `${out}/${file}`));
    const builds = await Promise.all(files.map(async (path) => {
      const bytes = await Bun.file(path).bytes();
      const [, what, kind] = path.split("/").pop().match(/^(server-runtime|server-code|server|one-setup|one-cli|one)-?(.*?)(\.tar\.gz|\.gz|\.exe)$/);
      // A runtime and a client are told by what they were built from, and a `one` by what a server runs of it.
      const said = async (ext) => { const file = Bun.file(path.replace(/(\.tar\.gz|\.gz|\.exe)$/, ext)); return (await file.exists()) ? (await file.text()).trim() : undefined; };
      const name = kind ? `${what}/${kind}` : what;
      const sha256 = new Bun.CryptoHasher("sha256").update(bytes).digest("hex");
      const signature = sign(null, Buffer.from(`${name} ${BUILD} ${sha256}`), key).toString("base64");
      return { path, what, kind, name, build: BUILD, inputs: await said(".inputs"), serves: await said(".serves"), sha256, signature, size: bytes.length };
    }));
    const at = `https://github.com/${REPO}/releases/download/${TAG}`;
    const TARGETS = ["linux-x86_64", "linux-aarch64", "macos-aarch64", "windows-x86_64"];
    const before = Object.fromEntries(await Promise.all(TARGETS.map(async (target) => {
      const listed = await fetch(`${at}/${target}.json`);
      return [target, listed.ok ? await listed.json() : null];
    })));
    const lists = structuredClone(before);
    for (const { what, kind, build, inputs, serves, sha256, signature, size } of builds) {
      for (const target of kind ? [kind] : TARGETS.filter((target) => lists[target] || builds.some((other) => other.kind === target))) {
        const list = (lists[target] ??= {});
        const was = list[what];
        list[what] = { build, sha256, size, signature, ...(inputs && { inputs }), ...(serves && { serves }), link: { method: "GET", url: `${at}/${sha256}` } };
        if (serves) list[what].serving = was?.serves === serves ? (was.serving ?? was.build) : build;
      }
    }
    const have = new Set(JSON.parse(gh("release", "view", TAG, "--json", "assets")).assets.map(({ name }) => name));
    const out = mkdtempSync(`${tmpdir()}/release-`);
    try {
      for (const { path, sha256 } of builds.filter(({ sha256 }) => !have.has(sha256))) {
        copyFileSync(path, `${out}/${sha256}`);
        gh("release", "upload", TAG, `${out}/${sha256}`);
        have.add(sha256);
      }
      const changed = TARGETS.filter((target) => lists[target] && JSON.stringify(lists[target]) !== JSON.stringify(before[target]));
      for (const target of changed) writeFileSync(`${out}/${target}.json`, JSON.stringify(lists[target], null, 2));
      if (changed.length) gh("release", "upload", TAG, "--clobber", ...changed.map((target) => `${out}/${target}.json`));
      const named = new Set([...Object.values(before), ...Object.values(lists)].flatMap((list) => Object.values(list ?? {}).map(({ sha256 }) => sha256)));
      for (const name of have) if (/^[0-9a-f]{64}$/.test(name) && !named.has(name)) gh("release", "delete-asset", TAG, name, "-y");
    } finally {
      rmSync(out, { recursive: true, force: true });
    }
    for (const { name, size } of builds) console.log(`${name}  ${BUILD}  ${(size / 1e6).toFixed(1)} MB`);
  ' "$@"
}

# Servers and clients share nothing but the release they publish to, so each is its own release, with its own lock and
# checkout (below), and one that asks for both builds the two at once. What they build is published together, as one
# update, so a server takes the server build and the `one` that runs it as one pair: published apart, a server took the
# new `one` alone, put in place beside the one running it, and then the server build as though its `one` hadn't changed
# (19 Nov). Each says where its builds are once they're built (`ONE_RELEASE_PAIR`), and says nothing where it built none.
want_servers=() want_clients=()
for want in "${wanted[@]}"; do
  case $want in server | server/*) want_servers+=("$want") ;; *) want_clients+=("$want") ;; esac
done
if ((${#want_servers[@]} && ${#want_clients[@]})); then
  pair=$(mktemp -d) && trap 'rm -rf "$pair"' EXIT
  ONE_RELEASE_PAIR=$pair "$0" ${dry:+--dry-run} "${want_servers[@]}" > >(sed 's/^/server: /') 2>&1 &
  server=$!
  ONE_RELEASE_PAIR=$pair "$0" ${dry:+--dry-run} "${want_clients[@]}" > >(sed 's/^/client: /') 2>&1 &
  client=$!
  # Each has built once it says where, or has ended; the iPhone's app goes on to TestFlight after.
  for part in server client; do
    pid=${!part}
    until [[ -e $pair/$part ]] || ! kill -0 "$pid" 2>/dev/null; do sleep 1; done
  done
  # A part that built nothing wrote no file, so only the parts that built are read.
  built=($(cat "$pair"/server "$pair"/client 2>/dev/null || :))
  status=0
  if ((${#built[@]})); then
    build=$(tooling/version)
    publish "${built[@]}" || status=1
    echo "Every network's servers take $build by themselves within five minutes (\`one builds\` says how far), and a device with \`one update\`."
  fi
  wait "$server" || status=1
  wait "$client" || status=1
  exit $status
fi
part=server
((${#want_servers[@]})) || part=client

# Each line says how many seconds into the release it is, so where a release's time goes is in what it printed.
[[ $(uname) != Linux ]] || exec > >(while IFS= read -r line; do printf '%4ds %s\n' "$SECONDS" "$line"; done) 2>&1

# A network's iPhone app goes to TestFlight beside its computers' clients, where its native code changed
# (`tooling/testflight`), built from the network's repo, which ONE_NETWORK_REPO names (Agent Memory says where it is).
# The release ends once Apple has taken the upload, and fails if it doesn't.
iphone=
if [[ $part == client && " ${wanted[*]} " == *" client "* && -z $dry ]]; then
  if [[ -z ${ONE_NETWORK_REPO:-} ]]; then
    echo "The iPhone's app isn't built: ONE_NETWORK_REPO names the network's repo, which it's built from"
  elif one builds | jq -e '[.devices[] | select(.target | startswith("ios-"))] | length > 0' >/dev/null; then
    tooling/testflight "$ONE_NETWORK_REPO" > >(sed 's/^/iphone: /') 2>&1 &
    iphone=$!
  fi
fi
# The machine's lock goes first, as waiting for Apple holds up nothing here: the next client release (19 Nov: 164 s).
iphone_done() {
  exec 9>&-
  [[ -z $iphone ]] || wait "$iphone" || { echo "The iPhone's app didn't reach TestFlight." >&2 && exit 1; }
}
trap iphone_done EXIT

# A build is named by its commit's version (`tooling/version`), so what's built is all committed.
[[ -z $(git status --porcelain) ]] || { echo "Commit what's changed first: a build is named by its commit." >&2 && exit 1; }
# And what's built is on main: a commit whose push lost a race to another's isn't, and built, it would publish a build
# without the newer commits main has, undoing them where it's taken (19 Nov).
git fetch -q origin main
git merge-base --is-ancestor HEAD origin/main ||
  { echo "$(git rev-parse --short HEAD) isn't on origin/main: rebase onto it, push, then release." >&2 && exit 1; }
build=$(tooling/version)
commit=$(git rev-parse HEAD)
here="$(uname -s | sed -e s/Linux/linux/ -e s/Darwin/macos/)-$(uname -m | sed s/arm64/aarch64/)"

# One release of each part on a machine at a time, as each builds in the checkout kept for its part (below): a second
# waits for the first, and then finds what the network has published since. The lock is a flock every process the
# release starts holds, so it's held until the last of them ends, even when the release is stopped and they aren't;
# a pid file, released as the script ended, let a release start over the builds of one stopped before it, and two
# releases take a lock released between their looks at it (18 Nov). A daemon a build starts would hold it too, as long
# as it runs: the compiler cache's, sccache (`~/.cargo/config.toml`), is started before it's taken. A release looks at
# what the network has before it waits, and as it waits, and ends at once, as a covered one does, when the release it
# waits for, or one published since, is of a commit that has its changes.
kept=${XDG_CACHE_HOME:-$HOME/.cache}/the-one-app/release-$part

triple() {
  case $1 in
    linux-x86_64) echo x86_64-unknown-linux-gnu ;;
    linux-aarch64) echo aarch64-unknown-linux-gnu ;;
    macos-aarch64) echo aarch64-apple-darwin ;;
    windows-x86_64) echo x86_64-pc-windows-msvc ;;
  esac
}

# What a client for a kind of machine is built from: its crate and what it's built with (`tooling/input-hash`), the UI
# library it has built in (`ui` in clients/app/build.rs), and the protocols it speaks (`core/protocol.json`). Its own
# build isn't in it: that's the version `one --version` says, so a client built for an earlier build still says what
# it is.
client_inputs() {
  { echo "$key" && tooling/input-hash clients/app "$(triple "$1")" && sha256sum core/protocol.json &&
    git ls-files -z core/ui/src core/ui/build.js core/ui/tables.ts core/ui/package.json core/ui/bun.lock | xargs -0 sha256sum; } |
    sha256sum | cut -d' ' -f1
}

# What a server runs of a client, `one serve run`: the crate it's in (`clients/cli`) and what that's built with, and the
# protocols it speaks. Kept with a `one` as its `serves`, so the network's servers restart for a new `one` only where
# this changed (`OneCore.Builds`), not for each change to the app around it.
serve_inputs() {
  { echo "$key" && tooling/input-hash clients/cli "$(triple "$1")" && sha256sum core/protocol.json; } | sha256sum | cut -d' ' -f1
}

# Whether a client is the network's latest already: built from what it would be now.
unchanged() {
  local latest
  latest=$(jq -r --arg n "$1" --arg i "$(client_inputs "${1#*/}")" '.latest[$n] | select(.inputs == $i) | .build' <<<"$builds")
  [[ -n $latest ]] && echo "$latest"
}

# Whether a build is this commit's, or a newer one's on main, which has its changes.
covers() {
  local sha=${1##*[-.]}
  [[ $commit == "$sha"* ]] || { git cat-file -e "$sha^{commit}" 2>/dev/null && git merge-base --is-ancestor "$commit" "$sha"; }
}

# What the network has, and which of what's asked for it has none of from this commit or a newer one: those are `mine`,
# to build, and `notes` says why each of the rest isn't.
survey() {
  builds=$(one builds)
  git fetch -q origin main
  # What's asked for, by name. A desktop or the CLI is built for each kind of machine a device of the network's is,
  # but a phone, whose app the network's owner builds.
  names=()
  for want in "${wanted[@]}"; do
    case $want in
      server) names+=($(jq -r '.servers[].target | "server/" + .' <<<"$builds")) ;;
      client) names+=($(jq -r '.devices[].target | select(startswith("linux-")) | "one/" + ., "one-cli/" + .' <<<"$builds")
        $(jq -r '.devices[].target | select(startswith("macos-")) | "one/" + .' <<<"$builds")
        $(jq -r '.devices[].target | select(startswith("windows-")) | "one/" + ., "one-cli/" + .' <<<"$builds")) ;;
      *) names+=("$want") ;;
    esac
  done
  names=($(printf '%s\n' "${names[@]}" | sort -u))

  # A release only while every server, the edge and every device that talks with a server now speaks a protocol it
  # does (`OneCore.Protocol`), so one that drops an old protocol waits until every part has the newer build. A part
  # that says none speaks none (`OneCore.Protocol.of/1`).
  behind=$(jq -r --argjson mine "$(cat core/protocol.json)" '
    def overlaps($b): . != null and $b != null and .oldest <= $b.newest and $b.oldest <= .newest;
    def talks: overlaps($mine);
    def named: if . == null then "none" elif .oldest == .newest then "\(.oldest)" else "\(.oldest) to \(.newest)" end;
    [.servers[] | .protocol] as $servers
    | [(.servers[] | select(.protocol | talks | not) | "\(.name) (protocol \(.protocol | named))"),
     (select(.edge != null and (.edge_protocol | talks | not)) | "the edge (protocol \(.edge_protocol | named))"),
     (.devices[] | .protocol as $its
       | select(($its | talks | not) and any($servers[]; . as $server | $its | overlaps($server)))
       | "\(.name) (protocol \(.protocol | named), on \(.build))")]
    | join(", ")' <<<"$builds")
  [[ -z $behind ]] || { echo "$build speaks protocol $(jq -r 'if .oldest == .newest then "\(.oldest)" else "\(.oldest) to \(.newest)" end' core/protocol.json), which $behind, doesn't: keep the protocol they speak until they have the newer build." >&2 && exit 1; }

  mine=() notes=()
  # Which are built here, and which are published already.
  for name in "${names[@]}"; do
    kind=${name#*/}
    # A server is published as its code, which is the same for every kind, and its kind's runtime, which a kind of
    # machine new to the network has none of yet.
    latest=$(jq -r --arg n "${name/#server\/*/server-code}" '.latest[$n].build // ""' <<<"$builds")
    if [[ -n $latest ]] && covers "$latest" &&
      { [[ $name != server/* ]] || jq -e --arg n "server-runtime/$kind" '.latest[$n]' <<<"$builds" >/dev/null; }; then
      if [[ $latest == "$build" ]]; then notes+=("$name  $build is published already"); else notes+=("$name  $latest is published, which has $build's changes"); fi
    elif [[ $name == server/* && $here != linux-* ]]; then
      echo "$name is built on Linux: build it there with tooling/release $name" >&2 && exit 1
    elif [[ $name == server/* || $kind == "$here" || ($here == linux-* && ($kind == windows-* || $name == one/macos-*)) ]]; then
      # A client's inputs name the Rust that builds it, which is this machine's, and GitHub's for a Mac's.
      if [[ $name != server/* ]] && was=$(unchanged "$name"); then
        notes+=("$name  built from the same as $was, which stays the latest")
      else
        mine+=("$name")
      fi
    else
      echo "$name isn't built on $here: build it on such a machine with tooling/release $name" >&2 && exit 1
    fi
  done
}

# A release with nothing left to build ends here, whenever that's found out, even while it waits.
covered() {
  ((${#mine[@]})) && return
  printf '%s\n' "${notes[@]}"
  exit 0
}

# Whether the release holding the lock is of a commit with this one's changes, for each build this one has left, so
# its wait is for nothing: it says so, and this one ends as a covered one does. The holder keeps what it releases
# beside the lock for as long as it holds it.
holding() {
  local held held_build held_commit held_wanted name want ok
  held=$(cat "$kept.releasing" 2>/dev/null) && read -r held_build held_commit held_wanted <<<"$held" || return 1
  [[ $commit == "$held_commit" ]] || { git cat-file -e "$held_commit^{commit}" 2>/dev/null && git merge-base --is-ancestor "$commit" "$held_commit"; } || return 1
  for name in "${mine[@]}"; do
    ok=
    for want in $held_wanted; do
      [[ $want == "$name" || ($want == server && $name == server/*) || ($want == client && $name != server/*) ]] && ok=yes
    done
    [[ -n $ok ]] || return 1
  done
  echo "$held_build from ${held_commit:0:12}, which has $build's changes, is publishing now: follow it with \`one builds\`."
}

survey && covered
if [[ -z $dry && $(uname) == Linux ]]; then
  mkdir -p "$(dirname "$kept")"
  ! command -v sccache >/dev/null || sccache --show-stats >/dev/null
  exec 9>>"$kept.lock"
  # It waits 30 s at a time, to look again at what the network has and what the holder releases, which is what it
  # waits for the end of.
  while ! flock -n 9; do
    holding && exit 0
    [[ -n ${waiting:-} ]] || echo "Waiting for the $part release of $(cat "$kept.lock") on this machine to finish"
    waiting=yes
    flock -w 30 9 || { survey && covered; }
  done
  echo "$build, pid $$" >"$kept.lock"
  echo "$build $commit ${wanted[*]}" >"$kept.releasing"
  trap 'rm -f "$kept.releasing"; iphone_done' EXIT
  # What the release before this one published.
  survey && covered
fi
((${#notes[@]})) && printf '%s\n' "${notes[@]}"
for name in "${mine[@]}"; do
  if [[ $name == one/macos-* && $here != macos-* ]]; then echo "$name  $build, built on GitHub"; else echo "$name  $build, built here"; fi
done
[[ -z $dry ]] || exit 0
# Windows' installer is made with NSIS, as most Windows apps' are, and Linux has it as a package.
[[ " ${mine[*]} " != *" one/windows-"* ]] || command -v makensis >/dev/null ||
  { echo "Windows' installer is made with makensis: sudo apt install nsis" >&2 && exit 1; }

# It builds in one checkout kept for releasing each part on this machine, put at the commit released, so each release
# builds, downloads and installs only what changed since the one before, as the Mac's ~/scratch/one-release does,
# rather than all of it again in each new worktree (most of a server's build, 17 Nov). A server's and a client's don't
# touch, so they build at once.
if [[ $(uname) == Linux ]]; then
  [[ -d $kept ]] || { git worktree prune && git worktree add -q --detach "$kept" "$commit"; }
  git -C "$kept" checkout -q --detach -f "$commit"
  root=$kept && cd "$root"
fi

servers=($(printf '%s\n' "${mine[@]}" | sed -n 's|^server/||p'))

# `one`, which is the app too, and on Linux `one-cli`, the same without its window, for a machine with no screen,
# which has no GTK or WebKitGTK; `one update` keeps each on its own. Building it for another kind of machine needs
# that machine's system libraries, so each kind builds its own. Each builds at once, beside the servers, in a target
# folder of its own: cargo holds one folder for one build at a time. A Mac's is built on a Mac (`tooling/on-mac`), with
# this machine's Rust, so it's what `client_inputs` says it's built from.
target=${CARGO_TARGET_DIR:-$root/target}

# Signs a Windows program, with jsign, once there's a certificate to sign with: WINDOWS_SIGNING is jsign's options
# naming it, as `--storetype TRUSTEDSIGNING --keystore <region>.codesigning.azure.net --storepass <token> --alias
# <account>/<profile>` for Microsoft's Artifact Signing, or `--keystore <file>.pfx --storepass <password>` for a
# certificate of one's own. Without one, it ships unsigned, and SmartScreen asks its person before it runs.
signed() {
  [[ -z ${WINDOWS_SIGNING:-} ]] || jsign $WINDOWS_SIGNING --tsaurl http://timestamp.acs.microsoft.com --tsmode RFC3161 "$1"
}
out=$target/builds/$build
rm -rf "$out" && mkdir -p "$out"
# cargo-xwin links its clang-cl again each time it starts, which two at once on a machine fail at, so it builds one
# thing at a time there, as `tooling/nifs` does too.
xwin=(flock -o "${XDG_CACHE_HOME:-$HOME/.cache}/cargo-xwin.lock" cargo xwin build --target x86_64-pc-windows-msvc)
# Builds the client `$1`. Windows shows a program by its version resource and icon, as in Windows Firewall's prompt:
# one's are the One App's. It's named there as its file is, one.exe. The app comes with its installer, made with NSIS,
# the One App's by the same, and each is signed once it's what it ships as.
client() {
  local name=$1 file cargo program exe setup
  file=$(tr / - <<<"$name")
  case $name in
    one-cli/windows-*) cargo=("${xwin[@]}" --no-default-features) program=x86_64-pc-windows-msvc/release/one.exe ;;
    one/windows-*) cargo=("${xwin[@]}") program=x86_64-pc-windows-msvc/release/one.exe ;;
    one-cli/*) cargo=(cargo build --no-default-features) program=release/one ;;
    one/*) cargo=(cargo build) program=release/one ;;
  esac
  echo "Building $name" && CARGO_TARGET_DIR=$target/clients/$file "${cargo[@]}" --release -p app &&
    mkdir "$out/$file.d" && cp "$target/clients/$file/$program" "$out/$file.d/" && exe=$out/$file.d/$(basename "$program") &&
    { [[ $name != *windows-* ]] || { VERSION=${build%%+*} tooling/windows-name "$exe" && signed "$exe"; }; } &&
    { [[ $name != one/windows-* ]] || {
      setup=$out/one-setup-${name#*/}.exe &&
        makensis -V2 -DVERSION="${build%%+*}" -DPROGRAM="$exe" -DOUTFILE="$setup" -DCOPYRIGHT="$(grep -m1 '^Copyright' LICENSE)" clients/app/installer.nsi &&
        signed "$setup" && client_inputs "${name#*/}" >"${setup%.exe}.inputs"
    }; } &&
    gzip -9 -c "$exe" >"$out/$file.gz" && rm -r "$out/$file.d" && client_inputs "${name#*/}" >"$out/$file.inputs" &&
    serve_inputs "${name#*/}" >"$out/$file.serves"
}
clients=()
for name in "${mine[@]}"; do
  file=$(tr / - <<<"$name")
  if [[ $name == one/macos-* && $here != macos-* ]]; then
    (echo "Building $name on a Mac" &&
      tooling/on-mac mac-client.yml "$file.gz" "$out" \
        'export RUSTUP_TOOLCHAIN=$RUST && cargo build --release -p app && gzip -9 -c target/release/one >'"$file.gz" \
        -f rust="$(rustc -V | cut -d' ' -f2)" &&
      client_inputs "${name#*/}" >"$out/$file.inputs" && serve_inputs "${name#*/}" >"$out/$file.serves" ||
      { echo "$name wasn't built." >&2 && exit 1; }) &
    clients+=($!)
  elif [[ $name == one/* || $name == one-cli/* ]]; then
    client "$name" &
    clients+=($!)
  fi
done

cache=$target/release-cache
mkdir -p "$cache"

# Downloads a file once, into the cache, checked against its SHA-256.
fetched() {
  local file=$cache/$2
  [[ -e $file ]] || { curl -fsSL -o "$file.part" "$1" && mv "$file.part" "$file"; }
  [[ $(sha256sum "$file" | cut -d' ' -f1) == "$3" ]] || { echo "$1 isn't what it should be" >&2 && rm "$file" && exit 1; }
  echo "$file"
}

if ((${#servers[@]})); then
  # The servers' NIFs, for the kinds of machine they're built for, the UI library, and code mode's interpreter, bundled
  # into One Core's priv/, each while the rest gets ready.
  tooling/nifs "${servers[@]}" &
  nifs=$!
  (cd core/ui && bun install --frozen-lockfile >/dev/null && bun build.js >/dev/null) &
  ui=$!
  (cd core/codemode && bun install --frozen-lockfile >/dev/null && bun run build >/dev/null) &
  codemode=$!
  otp=$(erl -noshell -eval '{ok, V} = file:read_file(filename:join([code:root_dir(), "releases", erlang:system_info(otp_release), "OTP_VERSION"])), io:put_chars(string:trim(V)), halt().')
  bun=$(bun --version)
  # What strips the VM's debugging symbols, for any kind of machine: Rust's own LLVM tools.
  objcopy=$(rustc --print sysroot)/lib/rustlib/$(rustc -vV | sed -n 's/^host: //p')/bin/llvm-objcopy
  [[ -x $objcopy ]] || rustup component add llvm-tools
  (cd core/server && mix deps.get --only prod >/dev/null)
  bun_sums=$(curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v$bun/SHASUMS256.txt")
  # Git for a Windows server, which Linux and a Mac have of their own: Git for Windows' MinGit, made for programs to
  # carry.
  mingit=2.56.1
  mingit_url=https://github.com/git-for-windows/git/releases/download/v$mingit.windows.1/MinGit-$mingit-64-bit.zip
  mingit_sum=$(curl -fsSL "https://api.github.com/repos/git-for-windows/git/releases/tags/v$mingit.windows.1" |
    jq -r --arg z "MinGit-$mingit-64-bit.zip" '.assets[] | select(.name == $z) | .digest | ltrimstr("sha256:")')
  wait "$nifs" || { echo "The servers' NIFs weren't built." >&2 && exit 1; }
  wait "$ui" || { echo "The UI library wasn't built." >&2 && exit 1; }
  wait "$codemode" || { echo "Code mode's interpreter wasn't bundled." >&2 && exit 1; }
fi

packing=() code=()
for kind in "${servers[@]}"; do
  echo "Building the server for $kind"
  case $kind in
    linux-x86_64) hex=amd64 bunzip=bun-linux-x64-baseline.zip ;;
    linux-aarch64) hex=arm64 bunzip=bun-linux-aarch64.zip ;;
    macos-aarch64) bunzip=bun-darwin-aarch64.zip ;;
    windows-x86_64) bunzip=bun-windows-x64-baseline.zip ;;
    *) echo "There's no server for $kind" >&2 && exit 1 ;;
  esac
  triple=$(triple "$kind")

  # The VM and OTP for that machine, from Hex's builds for Linux, Erlang/OTP's own for Windows and the Erlang
  # Ecosystem Foundation's for a Mac, fetched once.
  vm=$cache/otp-$otp-$kind
  if [[ ! -d $vm ]]; then
    if [[ $kind == linux-* ]]; then
      sum=$(curl -fsSL "https://builds.hex.pm/builds/otp/$hex/ubuntu-22.04/builds.txt" | awk -v v="OTP-$otp" '$1 == v { print $4 }')
      archive=$(fetched "https://builds.hex.pm/builds/otp/$hex/ubuntu-22.04/OTP-$otp.tar.gz" "otp-$otp-$kind.tar.gz" "$sum")
    elif [[ $kind == windows-* ]]; then
      zip=otp_win64_$otp.zip
      sum=$(curl -fsSL "https://api.github.com/repos/erlang/otp/releases/tags/OTP-$otp" | jq -r --arg z "$zip" '.assets[] | select(.name == $z) | .digest | ltrimstr("sha256:")')
      archive=$(fetched "https://github.com/erlang/otp/releases/download/OTP-$otp/$zip" "otp-$otp-$kind.zip" "$sum")
    else
      url="https://github.com/erlef/otp_builds/releases/download/OTP-$otp/otp-aarch64-apple-darwin.tar.gz"
      [[ -e $cache/otp-$otp-$kind.tar.gz ]] || curl -fsSL -o "$cache/otp-$otp-$kind.tar.gz" "$url"
      archive=$cache/otp-$otp-$kind.tar.gz
    fi
    rm -rf "$vm.part" && mkdir -p "$vm.part"
    if [[ $kind == windows-* ]]; then
      unzip -q "$archive" -d "$vm.part" -x 'doc/*' '*.pdb' '*/doc/*' '*/src/*' '*/examples/*' '*/beam.debug.smp.dll'
      # The VM needs the Visual C++ runtime, which a PC may not have: its DLLs go beside it, as Microsoft lets an
      # app carry them, from the installer of it that comes with Erlang/OTP.
      (cd "$vm.part" && 7z x -t# -y -ovc_redist vc_redist.exe >/dev/null && 7z x -y -ovc_redist/cabs vc_redist/4.cab >/dev/null &&
        cab=$(grep -l vcruntime140.dll_amd64 vc_redist/cabs/*) &&
        for dll in vcruntime140 vcruntime140_1 msvcp140; do 7z e -y -so "$cab" "$dll.dll_amd64" >"$(echo erts-*)/bin/$dll.dll"; done &&
        rm -r vc_redist vc_redist.exe)
    else
      tar -xzf "$archive" -C "$vm.part" --strip-components=1
    fi
    mv "$vm.part" "$vm"
  fi
  # Hex's builds are made whole where they're put by their own script.
  [[ ! -x $vm/Install || -e $vm/bin/erl ]] || (cd "$vm" && ./Install -minimal "$vm" >/dev/null)

  release=$target/release-builds/$kind
  rm -rf "$release"
  (cd core/server && MIX_ENV=prod ONE_ERTS=$(echo "$vm"/erts-*) mix release --overwrite --quiet --path "$release")
  # The NIFs of OTP's own applications as they're built for that machine. Their code runs on any.
  for app in "$release"/lib/*; do
    [[ ! -d $vm/lib/$(basename "$app")/priv ]] || { rm -rf "$app/priv" && cp -R "$vm/lib/$(basename "$app")/priv" "$app/priv"; }
  done
  priv=$(echo "$release"/lib/one_core-*)/priv/native
  rm -rf "$priv" && mkdir -p "$priv"
  for nif in core/server/nif/*/$kind.so; do
    # The VM loads a NIF by its name without its extension, which on Windows is a DLL's.
    crate=$(basename "$(dirname "$nif")")
    if [[ $kind == windows-* ]]; then cp "$nif" "$priv/$crate.dll"; else cp "$nif" "$priv/$crate.so"; fi
  done
  # Windows' VM keeps its debugging symbols apart already. It's the One App's there, by name, icon and publisher, which
  # Windows Firewall asks a person about as the server takes connections, rather than Erlang, which nobody there knows
  # they have.
  if [[ $kind == windows-* ]]; then tooling/windows-name "$(echo "$release"/erts-*/bin/erl.exe)"; else
    "$objcopy" --strip-all "$(echo "$release"/erts-*/bin/beam.smp)"; fi
  # A Mac's VM is signed with the Developer ID, on the Mac and in the background there, as macOS's firewall lets
  # signed software take connections without asking. Without the hardened runtime, which would need entitlements for
  # its JIT. The keychain is the one `tooling/mac-helper` signs with.
  if [[ $kind == macos-* ]]; then
    beam=$(echo "$release"/erts-*/bin/beam.smp)
    ssh -o ConnectTimeout=15 mac "bash -c $(printf %q "$(cat <<'SIGN'
keychain=$HOME/Library/Keychains/ptc-build.keychain-db
d=$(mktemp -d) && trap 'rm -r "$d"; security lock-keychain "$keychain"' EXIT && cat >"$d/beam.smp"
# The password goes to security on its standard input, never in a command line, where ps and logs see it.
printf 'unlock-keychain -p "%s" "%s"\n' "$(cat ~/.config/ptc/build-keychain-pw)" "$keychain" | security -i >/dev/null
nice -n 19 taskpolicy -d throttle codesign --force --timestamp --keychain "$keychain" --sign "Developer ID Application" "$d/beam.smp" >&2
codesign --verify --strict "$d/beam.smp" >&2 && cat "$d/beam.smp"
SIGN
)")" <"$beam" >"$beam.signed"
    cat "$beam.signed" >"$beam" && rm "$beam.signed"
  fi

  # What it ships with: the UI library's build, which it builds apps against and serves, and the Bun it builds apps
  # with. What its NIFs were built from is beside them, for `tooling/nifs` to find a Mac's again.
  [[ ! -e $target/nifs/$kind ]] || cp "$target/nifs/$kind" "$release/nifs"
  cp -R core/ui/dist "$release/ui"
  echo "https://github.com/oven-sh/bun/releases/download/bun-v$bun/$bunzip $(awk -v z="$bunzip" '$2 == z { print $1 }' <<<"$bun_sums")" >"$release/bun"
  [[ $kind != windows-* ]] || echo "$mingit_url $mingit_sum" >"$release/git"

  # The runtime is everything but One Core's own code. What it's built from says which it is: the one published, if
  # that's the same, and otherwise a new one, this build's. That's the VM, Elixir and Bun, the deps, One Core's config
  # and release settings and this loop, which puts them together; and One Core's NIFs, as each is named for what it's
  # built from (`tooling/input-hash`).
  runtime_inputs=$({
    echo "$kind $otp $(elixir --version | tail -1) $key" && cat "$release/bun" && { [[ ! -e $release/git ]] || cat "$release/git"; } &&
      (cd core/server && sha256sum mix.exs mix.lock config/* rel/*) &&
      sed -n '/^for kind in "${servers\[@\]}"; do$/,/^done$/p' tooling/release
  } | sha256sum | cut -d' ' -f1)
  inputs=$({
    echo "$runtime_inputs" && for crate in core/server/nif/*/; do tooling/input-hash "$crate" "$triple"; done
  } | sha256sum | cut -d' ' -f1)
  runtime=$(jq -r --arg n "server-runtime/$kind" --arg i "$inputs" '.latest[$n] | select(.inputs == $i) | .build' <<<"$builds")
  echo "${runtime:-$build}" >"$release/runtime"
  if [[ -z $runtime ]]; then
    echo "$inputs" >"$out/server-runtime-$kind.inputs"
    (cd "$release" && find . -type f ! -path './releases/*' ! -path './ui/*' \
      \( ! -path './lib/one_core-*' -o -path './lib/one_core-*/priv/native/*' \) -print0 |
      tar -czf "$out/server-runtime-$kind.tar.gz" --null --no-recursion -T -) &
    packing+=($!)
  fi
  # One Core's own code is the same for every kind, so it's packed from the first.
  ((${#code[@]})) || {
    tar -czf "$out/server-code.tar.gz" -C "$release" --exclude='./lib/one_core-*/priv/native' ./releases ./ui $(cd "$release" && echo ./lib/one_core-*) &
    code=($!) && packing+=($!)
  }
done
# Each is packed while the next kind builds.
for pack in "${packing[@]}"; do wait "$pack" || { echo "A server wasn't packed." >&2 && exit 1; }; done

for client in "${clients[@]}"; do wait "$client" || { echo "A client wasn't built." >&2 && exit 1; }; done

# Publishes what was built, or with the other part's, says where it is for the release that asked for both.
if [[ -n ${ONE_RELEASE_PAIR:-} ]]; then
  ! ((${#mine[@]})) || { echo "$out" >"$ONE_RELEASE_PAIR/$part.writing" && mv "$ONE_RELEASE_PAIR/$part.writing" "$ONE_RELEASE_PAIR/$part"; }
  echo "Built: published with the $([[ $part == server ]] && echo clients || echo server) as one update"
else
  ! ((${#mine[@]})) || publish "$out"
  echo "The network's servers take $build by themselves (\`one builds\` says how far), and a device with \`one update\`."
fi
