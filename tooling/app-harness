#!/usr/bin/env bash
# The app harness: the app itself (its client, the channel its windows talk over, its launcher, a second start, an
# update's restart) on the renderer's fake platform, its native windows drawn offscreen on a thread of their own
# (`clients/app`'s `fake`), against a network on this machine (`tooling/network`), driven by the inspector as an agent
# drives a device's. What the headless harness (`examples/screenshot/main.rs`) can't reach, as it draws one page with no
# app around it.
#
#     tooling/app-harness <folder> [--seed <n>] [--phone] [<check>…]
#
# Each check says `ok` or `FAILED` and why, and it exits 1 if one failed. With none named, all run:
#
#   start    after a start, the launcher is open, and no app has two windows.
#   reopen   an app's window closed as its system closes it (`inspector close`) opens again from a `one:` link.
#   closed   the launcher closed as its system closes it (`inspector close`) is there again: a phone's Home Screen, a
#            window, opens again in its place, or says it didn't open, with Try Again; a computer's panel is put away.
#   reloaded a phone's page loaded again as its system has it, its native windows left: one launcher, which answers.
#   stale    the app started as an update starts it, its Home Screen and Settings updated while it wasn't running
#            (the files it kept then stale): one window of each app, at every moment.
#   cached   a view's read while the server holds every request, after a write of its own: answered at once, from
#            what its client kept.
#   restart  updates in a row (the program's file changes), each with a second start near the hand-over: one app,
#            whose launcher answers, and one window of each app, at the end of each.
#   updated  the Home Screen's page updated while it's open, a few times in a row, as a release deploys it: each time it
#            opens again in its place, and has a window a moment later.
#   twice    the Home Screen's page updated twice, the second landing as its window for the first opens again, its
#            page still starting: one Home Screen window at every moment, and it ends on the version a fresh start loads.
#   blank    an app's window opened while the server holds every request, so its page can't be read: still blank
#            5 s on, it says so, and Telemetry hears it once the server answers, with the step its opening reached.
#   loading  an app's window opened while the server holds every request, so its page can't be read: the app's
#            background as soon as it's listed, never black, and a second on its loading state, a spinner over "Loading".
#   open    the app started as an update starts it, its windows to open again, on the Surface's costs
#            (`measured.surface.open` in core/ui/devices.json): each window is made before the pipelines it draws with
#            could have been compiled, so it waited for none being compiled, and none of its page's start.
#
# The folder keeps the network, the app's build and its log (`app.log`), and a network running there is used again.
# `--seed` picks the moments things happen at, the same each time for the same seed. `--phone` runs a phone's app
# instead (`clients/app`'s `phone`): Tauri's, its event loop and its page (in WebKitGTK), and its native windows a
# phone's (`Native::phone`), each the whole of a 390 × 844 screen, the launcher its Home Screen, the root window under
# every app's, which its system can close, where a computer's is a panel it only puts away. It needs what
# `tooling/network` does, and `xvfb-run`, `dbus-run-session` and ImageMagick's `import`, as the app's event loop is
# GTK's on Linux.
set -euo pipefail
shopt -s extglob
root=$(cd "$(dirname "$0")/.." && pwd)
usage="tooling/app-harness <folder> [--seed <n>] [--phone] [start|reopen|closed|reloaded|stale|cached|restart|updated|twice|blank|loading|open]…"
folder= seed=1 phone= checks=()
while (($#)); do
  case $1 in
    --seed) seed=${2:?$usage} && shift ;;
    --phone) phone=390x844 ;;
    start | reopen | closed | reloaded | stale | cached | restart | updated | twice | blank | loading | open) checks+=("$1") ;;
    -*) echo "$usage" >&2 && exit 1 ;;
    *) folder=$1 ;;
  esac
  shift
done
[[ -n $folder ]] || { echo "$usage" >&2 && exit 1; }
((${#checks[@]})) || checks=(start reopen closed reloaded stale cached restart updated twice blank loading open)
mkdir -p "$folder/app"
folder=$(cd "$folder" && pwd)
RANDOM=$seed
one=$root/target/debug/one

# The app's build, beside the network's `one`, which it doesn't replace: a computer's, or with `--phone` a phone's (Tauri's
# app, its page in WebKitGTK). Its program is a script that says it's a newer build than any, so a change to it is an
# update the app starts again on (`updater::in_place`), as one does.
(cd "$root" && cargo build -p app --bin one --features "$([[ -n $phone ]] && echo phone || echo fake)")
cp "$one" "$folder/app/one-real.new" && mv -f "$folder/app/one-real.new" "$folder/app/one-real"
cat >"$folder/app/one" <<'EOF'
#!/bin/sh
[ "$1" = --version ] && exec echo "one 0.0.0+999999999.harness"
exec "$(dirname "$0")/one-real" "$@"
EOF
chmod +x "$folder/app/one"

net=$folder/network
if ! { [[ -s $net/pid ]] && kill -0 "$(cat "$net/pid")" 2>/dev/null; }; then
  setsid "$root/tooling/network" "$net" >"$folder/network.log" 2>&1 &
  grep -q -m1 "Its address is" <(tail -F --pid=$! -n +1 "$folder/network.log") || { cat "$folder/network.log" >&2 && exit 1; }
fi
# The seed makes the app's windows' thread as busy as a loaded device's, too (`platform::start`, fake).
export ONE_HOME=$net/client ONE_AS=owner ONE_PROGRAM=$folder/app/one ONE_SEED=$seed
[[ -z $phone ]] || export ONE_PHONE=$phone
for wanted in inspector settings telemetry; do
  ONE_SUBJECT=network "$one" apps | jq -e --arg app "$wanted" 'any(.apps[]; .name == $app)' >/dev/null ||
    ONE_SUBJECT=network "$one" install --app "network/apps/$wanted" >/dev/null
done

log=$folder/app.log
: >"$log"
app=
# A desktop of its own, its display and session bus, which outlives each app started on it, as a person's does: the
# app's event loop is GTK's, and without `dbus-run-session` GTK waits half a minute for a desktop that isn't there.
rm -f "$folder/desktop.env"
setsid dbus-run-session -- xvfb-run -a sh -c 'env | grep -E "^(DISPLAY|XAUTHORITY|DBUS_SESSION_BUS_ADDRESS)=" >"$0"; exec sleep infinity' "$folder/desktop.env" >/dev/null 2>&1 &
desktop=$!
# Within `$1` seconds, the condition `$2` holds, asked again every fifth of a second, as Playwright's expect polls.
within() {
  local until=$((SECONDS + $1))
  until eval "$2"; do
    ((SECONDS < until)) || return 1
    sleep 0.2
  done
}
said() { grep -c -- "$1" "$log" || true; }
# The app's windows, each `<window> <entrypoint>`.
windows() { "$one" inspector windows 2>/dev/null | jq -r '.windows[] | "\(.window) \(.entrypoint | split("/")[0])"'; }
open_window() { windows | awk -v app="$1" '$2 == app { print $1 }'; }
# The app's processes: the program it is, by its file, which a new build replaced is `(deleted)`.
programs() { for exe in /proc/[0-9]*/exe; do [[ $(readlink "$exe" 2>/dev/null) == "$folder/app/one-real"?(" (deleted)") ]] && echo "${exe//[^0-9]/}"; done; true; }
failed=0
check() { if "${@:2}"; then echo "ok      $1"; else echo "FAILED  $1" && failed=1; fi; }
# No app has two windows, now.
one_each() {
  local twice
  twice=$(windows | awk '{ print $2 }' | sort | uniq -d)
  [[ -z $twice ]] || { echo "        two windows of $twice: $(windows | tr '\n' ' ')" && return 1; }
}

start_app() {
  stop_app
  local opened
  opened=$(said "home-screen opened")
  setsid "$folder/app/one" >>"$log" 2>&1 &
  app=$!
  within 60 '(($(said "home-screen opened") > opened))' || { echo "        the app didn't open its launcher within a minute" && return 1; }
}
stop_app() {
  [[ -z $app ]] || kill -- "-$app" 2>/dev/null || true
  local pids
  pids=$(programs)
  [[ -z $pids ]] || kill $pids 2>/dev/null || true
  within 10 '[[ -z $(programs) ]]'
  app=
}
# A server the `cached` check stopped goes on, whatever happens to the check.
held=
trap '[[ -z $held ]] || kill -CONT "$held"; stop_app; kill -- "-$desktop" 2>/dev/null || true' EXIT
within 30 '[[ -s $folder/desktop.env ]]'
set -a && source "$folder/desktop.env" && set +a

started() {
  start_app || return 1
  within 10 '[[ -n $(open_window home-screen) ]]' || { echo "        the inspector lists no launcher" && return 1; }
  sleep 2
  one_each
}

reopened() {
  [[ -n $app ]] || start_app || return 1
  "$folder/app/one" one:settings
  within 20 '[[ -n $(open_window settings) ]]' || { echo "        Settings didn't open" && return 1; }
  "$one" inspector close --window "$(open_window settings)" >/dev/null
  within 5 '[[ -z $(open_window settings) ]]' || { echo "        Settings didn't close" && return 1; }
  "$folder/app/one" one:settings
  within 20 '[[ -n $(open_window settings) ]]' || { echo "        Settings closed by its system didn't open again" && return 1; }
}

# The launcher closed as its system closes it (`inspector close`): within 20 s it's there again, in a window that
# answers, pictured before and 2 s after (`closed-before.png`, `closed-after.png`). A phone's is a window, which closes,
# and opens again in its place, or where it can't, its page is told why and says so, with Try Again, pictured as its
# screen shows it (`closed-page.png`), where its page, told nothing, showed black until the app started again (21 Nov).
# A computer's is a panel, which is put away.
closed() {
  local launcher again told
  [[ -n $app ]] || start_app || return 1
  within 10 '[[ -n $(open_window home-screen) ]]' || { echo "        the inspector lists no launcher" && return 1; }
  launcher=$(open_window home-screen)
  told=$(said "its page says why")
  snap "$launcher" "$folder/closed-before.png"
  echo "        closed: $("$one" inspector close --window "$launcher" | jq -c .)"
  within 20 '(($(said "its page says why") > told)) || { [[ -n $(open_window home-screen) ]] && "$one" inspector tree --window "$(open_window home-screen)" >/dev/null 2>&1; }' ||
    { echo "        no launcher answers 20 s after window $launcher was closed, and its page wasn't told why: $(windows | tr '\n' ' ')" && return 1; }
  if (($(said "its page says why") > told)); then
    grep -o "its page says why: .*" "$log" | tail -1 | sed 's/^/        /'
    sleep 2 && import -window root "$folder/closed-page.png"
    return
  fi
  again=$(open_window home-screen)
  echo "        the launcher was window $launcher, and is $again"
  sleep 2 && snap "$again" "$folder/closed-after.png"
  one_each
}

# A phone's page loaded again as its system has it, while its native windows stay: iOS loads it again as it ends its web
# view's process in the background (Tauri's `on_web_content_process_terminate`), and Android as it makes its activity
# again. Here its web process ends, which a phone's app on Linux loads its page again after, as an iPhone's does.
# Within 20 s the launcher is a new window that answers, and a moment later the only one, where the page, which knew
# nothing of the old one, opened a second over it (21 Nov). A computer's launcher has no page.
reloaded() {
  local launcher web
  [[ -n $phone ]] || { echo "        a computer's launcher has no page" && return 0; }
  [[ -n $app ]] || start_app || return 1
  within 10 '[[ -n $(open_window home-screen) ]]' || { echo "        the inspector lists no launcher" && return 1; }
  launcher=$(open_window home-screen)
  web=$(ps -o pid=,comm= --ppid "$(programs | head -1)" | awk '$2 == "WebKitWebProces" { print $1 }')
  [[ -n $web ]] || { echo "        the app's page has no web process" && return 1; }
  kill -KILL $web
  within 20 '[[ -n $(open_window home-screen) && $(open_window home-screen) != *"$launcher"* ]] && "$one" inspector tree --window "$(open_window home-screen | tail -1)" >/dev/null 2>&1' ||
    { echo "        no new launcher answers 20 s after the page's web process ended: $(windows | tr '\n' ' ')" && return 1; }
  sleep 3
  echo "        the launcher was window $launcher, and is $(open_window home-screen | tr '\n' ' ')"
  one_each
}

# New versions of the Home Screen and of Settings while the app isn't running, then the app started as an update
# starts it, with Settings' window to open again: each page opens from the files its client kept, which it then hears
# are stale, as after an update of the client. One window of each app at every moment.
stale() {
  local twice name
  stop_app
  for name in home-screen settings; do
    rm -rf "$folder/$name" && cp -r "$root/apps/$name" "$folder/$name"
    echo "// a version of its own: $seed $(date +%s%N)" >>"$(find "$folder/$name/client" -maxdepth 1 -name '*.tsx' | head -1)"
    ONE_SUBJECT=network "$one" deploy --name "$name" --files-from "$folder/$name" >/dev/null || { echo "        $name: its deploy failed: an app deploys only from a commit on origin/main" && return 1; }
  done
  ONE_REOPEN='[["settings/client/index.html",null]]' setsid "$folder/app/one" >>"$log" 2>&1 &
  app=$!
  # And another of the Home Screen a moment later (0-3 s, as the seed says), as it opens again on the first.
  local delay=$((RANDOM % 3000))
  sleep "$(printf '%d.%03d' $((delay / 1000)) $((delay % 1000)))"
  echo "// and another: $(date +%s%N)" >>"$(find "$folder/home-screen/client" -maxdepth 1 -name '*.tsx' | head -1)"
  ONE_SUBJECT=network "$one" deploy --name home-screen --files-from "$folder/home-screen" >/dev/null &
  local deployed=$!
  for _ in $(seq 75); do
    twice=$(windows | awk '{ print $2 }' | sort | uniq -d | tr '\n' ' ')
    [[ -z $twice ]] || break
    sleep 0.2
  done
  wait $deployed || { echo "        home-screen: its deploy failed: an app deploys only from a commit on origin/main" && return 1; }
  [[ -z $twice ]] || { echo "        another Home Screen ${delay} ms after the start: two windows of $twice: $(windows | tr '\n' ' ')" && return 1; }
  one_each
}

# The network's server, the program of its node (`tooling/network`'s `node_name`), by the port it's listening on.
server() {
  local port
  port=$(epmd -names | awk -v node="server-$(printf %s "$net" | cksum | cut -d' ' -f1)" '$2 == node { print $5 }')
  ss -Hltnp "sport = :$port" | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2
}

# A view's read while its server holds every request (stopped, as one is that's restarting), after a write of its
# own: answered at once from what its client kept, as stale-while-revalidate has it, where it waited until the
# server was given up for gone (issue 26: windows ready in 22-34 s). It's asked as an app's window asks, over the
# app's own channel (`hosts::talk`), as a view of its own: a read another view kept, a write (a group made), the
# server stopped, then the read.
cached() {
  [[ -n $app ]] || start_app || return 1
  local channel
  channel=$(ss -Hxlp | awk -v pid="pid=$(programs | head -1)," 'index($0, pid) && /app\.theone\.client/ { print $5 }' | head -1)
  held=$(server)
  [[ -n $channel && -n $held ]] || { echo "        no channel ($channel) or no server ($held)" && return 1; }
  python3 - "$channel" "$held" <<'PY'
import json, os, signal, socket, sys, time
channel, held = sys.argv[1], int(sys.argv[2])
def view(name):
    talk = socket.socket(socket.AF_UNIX)
    talk.connect(channel)
    talk.settimeout(30)
    lines = talk.makefile("rw")
    lines.write(json.dumps({"hello": {"entrypoint": name, "subject": None, "link": name}}) + "\n")
    def ask(id, tool, arguments):
        lines.write(json.dumps({"id": id, "command": "request", "args": {"view": "|" + name, "method": "tools/call", "params": {"name": tool, "arguments": arguments}}}) + "\n")
        lines.flush()
        while True:
            line = lines.readline()
            if not line:
                raise SystemExit(f"        the app ended the channel as {name} asked {tool}")
            said = json.loads(line)
            if said.get("id") == id:
                if "error" in said:
                    raise SystemExit(f"        {tool} wasn't answered: {said['error'][:200]}")
                return said
    return talk, ask
_, warm = view("harness/kept")
warm("kept", "settings_apps", {})
talk, mine = view("harness/view")
mine("write", "permissions_group", {"name": f"harness {time.time_ns()}"})
os.kill(held, signal.SIGSTOP)
try:
    talk.settimeout(10)
    asked = time.monotonic()
    try:
        mine("read", "settings_apps", {})
        took = time.monotonic() - asked
    except TimeoutError:
        took = None
finally:
    os.kill(held, signal.SIGCONT)
if took is None or took > 1:
    print(f"        its read, after its write, with the server holding every request: {'no answer in 10 s' if took is None else f'{took:.1f} s'}")
    sys.exit(1)
print(f"        its read, after its write, with the server holding every request: {took * 1000:.0f} ms")
PY
  local answered=$?
  held=
  return $answered
}

# Updates in a row, each a second start 0-3 ms after the program before ends, or 0-1 s after.
restarted() {
  local round before old delay
  [[ -n $app ]] || start_app || return 1
  for round in 1 2 3 4 5; do
    before=$(said "the client opened")
    old=$(programs)
    touch "$folder/app/one"
    within 30 '! programs | grep -qx "$old"' || { echo "        update $round: the program before ($old) didn't end: $(programs | tr "\n" " ")" && return 1; }
    delay=$((round % 2 ? RANDOM % 4 : RANDOM % 1000))
    sleep "$(printf '0.%03d' "$delay")"
    "$folder/app/one" >>"$log" 2>&1
    within 30 '(($(said "the client opened") > before))' || { echo "        update $round: the new program didn't open" && return 1; }
    sleep 3
    [[ $(programs | wc -l) -eq 1 ]] || { echo "        update $round, a second start ${delay} ms after: $(programs | wc -l) apps" && return 1; }
    within 10 '[[ -n $(open_window home-screen) ]]' || { echo "        update $round: no launcher answers" && return 1; }
    one_each || { echo "        after update $round" && return 1; }
  done
}

# The Home Screen's page updated while it's open, three times, as a release deploys it: each time its window opens
# again in the old one's place, which is closed on the windows' thread, as busy as the seed has it, while the new one
# says it's there. A moment later it has a window, where a phone's new one was taken for a second window of the old,
# still closing, and told to quit, and its page, told nothing, showed black until the app started again (21 Nov).
updated() {
  local round
  [[ -n $app ]] || start_app || return 1
  rm -rf "$folder/home-screen" && cp -r "$root/apps/home-screen" "$folder/home-screen"
  for round in 1 2 3; do
    echo "// a version of its own: $seed $round $(date +%s%N)" >>"$(find "$folder/home-screen/client" -maxdepth 1 -name '*.tsx' | head -1)"
    ONE_SUBJECT=network "$one" deploy --name home-screen --files-from "$folder/home-screen" >/dev/null || { echo "        update $round: its deploy failed: an app deploys only from a commit on origin/main" && return 1; }
    sleep 3
    [[ -n $(open_window home-screen) ]] || { echo "        update $round: no Home Screen window 3 s after its page was updated: $(windows | tr '\n' ' ')" && return 1; }
    one_each || { echo "        after update $round" && return 1; }
  done
}

# The Home Screen's page the launcher shows, by its module's file, as its JS last started (`app.log`).
home_module() { grep -oP 'oneapp://home-screen\.localhost/home-screen/client/assets/\K[^ ]+(?=.s JS started)' "$log" | tail -1; }

# The Home Screen's page updated twice in a row, the second's news landing as the launcher's window for the first opens
# again, while its page is still starting: the first's takes seconds, as a slow device's may. One Home Screen window at
# every moment (two were seen once, in `stale`), and once they're done, the Home Screen shows the version a fresh start
# loads, where news a window's page hears while it starts could be lost, and the Home Screen stay on the first until
# the next update. News between a window's page being read and its being given it (`attach`), a few ms as the client
# keeps a version's files before it says so, isn't reached: holding them holds the second deploy too.
twice() {
  local copy twice shown fresh deploy until
  [[ -n $app ]] || start_app || return 1
  for copy in slow next; do rm -rf "$folder/home-screen-$copy" && cp -r "$root/apps/home-screen" "$folder/home-screen-$copy"; done
  # Code, not a comment, so each is a bundle of its own, which its module's file tells apart; the first's busy as it
  # starts.
  echo "Object.assign(globalThis, { harness: \"$seed slow $(date +%s%N)\" }); for (let i = 0; i < 12e8; i++);" >>"$folder/home-screen-slow/client/home.tsx"
  echo "Object.assign(globalThis, { harness: \"$seed next $(date +%s%N)\" })" >>"$folder/home-screen-next/client/home.tsx"
  ONE_SUBJECT=network "$one" deploy --name home-screen --files-from "$folder/home-screen-slow" >/dev/null || { echo "        its deploy failed: an app deploys only from a commit on origin/main" && return 1; }
  ONE_SUBJECT=network "$one" deploy --name home-screen --files-from "$folder/home-screen-next" >/dev/null &
  deploy=$!
  # Every moment while the second deploys, and 15 s after, as the launcher opens again on each.
  twice= until=
  while [[ -z $until ]] || ((SECONDS < until)); do
    [[ -n $until ]] || kill -0 "$deploy" 2>/dev/null || until=$((SECONDS + 15))
    twice=$(windows | awk '{ print $2 }' | sort | uniq -d | tr '\n' ' ')
    [[ -z $twice ]] || break
    sleep 0.2
  done
  wait "$deploy" || { echo "        its deploy failed: an app deploys only from a commit on origin/main" && return 1; }
  [[ -z $twice ]] || { echo "        two windows of $twice: $(windows | tr '\n' ' ')" && return 1; }
  one_each || return 1
  shown=$(home_module)
  start_app || return 1
  sleep 10
  fresh=$(home_module)
  echo "        the Home Screen after the updates: $shown; after a fresh start: $fresh"
  [[ $shown == "$fresh" ]] || { echo "        the Home Screen stayed on a version before the last update" && return 1; }
}

# An app's window opened while the server holds every request (stopped, as one is that's restarting), its page one
# the client hasn't kept (Telemetry's, with what the client kept gone as the app starts), so it can't be read: still
# blank 5 s after it opened, it says so (`Event::Blank`) where Andre's iPhone's blank windows said nothing (20 Nov), and
# Telemetry hears it once the server answers, with the last step its opening reached and the server's build.
blanked() {
  stop_app
  rm -rf "$ONE_HOME/cache"
  start_app || return 1
  local before
  before=$(said "window is blank")
  held=$(server)
  [[ -n $held ]] || { echo "        no server" && return 1; }
  kill -STOP "$held"
  "$folder/app/one" one:telemetry
  within 20 '(($(said "window is blank") > before))'
  local blank=$?
  kill -CONT "$held"
  held=
  ((blank == 0)) || { echo "        Telemetry's window didn't say it was blank 20 s after it opened" && return 1; }
  grep -o "telemetry's window is blank.*" "$log" | tail -1 | sed 's/^/        /'
  within 120 'ONE_SUBJECT=network "$one" telemetry errors --hours 1 | jq -e "any(.errors[]; .message | test(\"after it was on screen\"))" >/dev/null' ||
    { echo "        Telemetry didn't hear of it within 2 minutes of the server answering" && return 1; }
  ONE_SUBJECT=network "$one" telemetry errors --hours 1 | jq -r '.errors[] | select(.message | test("after it was on screen")) | "        Telemetry: \(.message)"' | head -1
}

# Window `$1` as it's drawn now, a PNG at `$2`.
snap() { "$one" inspector snap --window "$1" >"$2"; }

# The network's bucket, where an app's files are, by the port its edge says it's on (`tooling/network`).
bucket() {
  local port
  port=$(grep -oP 'bucket=127\.0\.0\.1:\K[0-9]+' "$net/edge.env")
  ss -Hltnp "sport = :$port" | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2
}

# An app's window opened while the bucket holds every request, its page one the client hasn't kept, so it can't be
# read, while the server, which the inspector answers through, goes on: as soon as the inspector lists it, it's the
# app's background with nothing on it, never black, and a second on, its loading state, a spinner over "Loading", in
# its middle. A phone's first start showed black for 5 s and more as its page was read, as a window whose page isn't
# there drew nothing (21 Nov).
loading() {
  stop_app
  rm -rf "$ONE_HOME/cache"
  start_app || return 1
  # The launcher answers the inspector, so its page and the inspector's code are read before the bucket holds them too:
  # held as the launcher's page is read, it doesn't open, and the link to Telemetry waits for it.
  within 30 '"$one" inspector tree --window "$(open_window home-screen)" >/dev/null 2>&1' || { echo "        the launcher didn't answer within 30 s" && return 1; }
  windows >/dev/null
  held=$(bucket)
  [[ -n $held ]] || { echo "        no bucket" && return 1; }
  kill -STOP "$held"
  "$folder/app/one" one:telemetry
  local window shown=0
  within 20 '[[ -n $(open_window telemetry) ]]' && window=$(open_window telemetry) &&
    snap "$window" "$folder/loading-first.png" && sleep 1 && snap "$window" "$folder/loading.png" && shown=1
  kill -CONT "$held"
  held=
  ((shown)) || { echo "        Telemetry's window wasn't listed, or wasn't drawn, within 20 s" && return 1; }
  python3 - "$folder/loading-first.png" "$folder/loading.png" <<'PY'
import sys
from PIL import Image
# Its background, as its bottom's middle is, and how many pixels of its middle differ from it.
def look(path):
    image = Image.open(path).convert("RGB")
    width, height = image.size
    background = image.getpixel((width // 2, height - 4))
    middle = image.crop((width // 4, height // 3, 3 * width // 4, 2 * height // 3))
    return background, sum(1 for pixel in middle.getdata() if sum(abs(a - b) for a, b in zip(pixel, background)) > 60)
(background, _), (_, marked) = look(sys.argv[1]), look(sys.argv[2])
print(f"        as it was listed, its background {background}; a second on, {marked} pixels marked in its middle")
failed = (["black as it was listed"] if max(background) < 40 else []) + (["nothing in its middle a second on"] if marked < 50 else [])
for why in failed:
    print(f"        {why}")
sys.exit(1 if failed else 0)
PY
}

# The app started as an update starts it, with Telemetry and Settings to open again beside the launcher, each made as
# the Surface makes one (its system's window and renderer, and the pipelines a kind of window draws with, which the
# first window after a start waits for): each window is made before those pipelines could have been compiled. One
# that waited for them, or for its page to start, as each did until 21 Nov (the Surface's 0.9 to 1.3 s; here 1.7 s),
# isn't. Its seed's busy thread isn't the Surface's costs, so it has none.
opened() {
  local window pipelines before made slow=
  stop_app
  window=$(jq '.measured.surface.open.window_ms' "$root/core/ui/devices.json")
  pipelines=$(jq '.measured.surface.open.pipelines_ms' "$root/core/ui/devices.json")
  before=$(said " was ready in ")
  ONE_SEED=0 ONE_WINDOW_MS=$window ONE_PIPELINES_MS=$pipelines ONE_REOPEN='[["telemetry/client/index.html",null],["settings/client/index.html",null]]' \
    setsid "$folder/app/one" >>"$log" 2>&1 &
  app=$!
  within 60 '(($(said " was ready in ") >= before + 3))' || { echo "        its three windows weren't ready within a minute" && return 1; }
  while read -r line; do
    made=$(grep -oP 'window made \K[0-9]+' <<<"$line" || echo none)
    echo "        ${line%% was ready*}: made in $made ms"
    [[ $made != none ]] && ((made < pipelines)) || slow=1
  done < <(grep " was ready in " "$log" | tail -n +$((before + 1)) | head -3)
  [[ -z $slow ]]
}

for name in "${checks[@]}"; do
  case $name in
    start) check "start: the launcher, and one window of each app" started ;;
    reopen) check "reopen: an app closed by its system opens again" reopened ;;
    closed) check "closed: the launcher closed by its system is there again" closed ;;
    reloaded) check "reloaded: a phone's page loaded again by its system leaves one launcher" reloaded ;;
    stale) check "stale: pages updated as the app starts, one window of each at every moment" stale ;;
    cached) check "cached: a read after a write is answered from what was kept while the server holds every request" cached ;;
    restart) check "restart: updates in a row, each with a second start, leave one app" restarted ;;
    updated) check "updated: the Home Screen updated while it's open opens again in its place, again and again" updated ;;
    twice) check "twice: the Home Screen updated again as it opens on an update ends on the last, with one window at every moment" twice ;;
    blank) check "blank: a window still blank 5 s after it opened says so, and Telemetry hears it" blanked ;;
    loading) check "loading: a window whose page can't be read is the app's background, then its loading state" loading ;;
    open) check "open: on the Surface's costs, each window opened again is made before its pipelines could compile" opened ;;
  esac
done
exit $failed
