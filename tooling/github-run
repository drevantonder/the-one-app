#!/usr/bin/env bash
# Runs a GitHub Actions workflow of this repo's on `main` and waits for it, as `gh workflow run` and `gh run watch`
# do, and says its run's id once it has succeeded:
#
#     tooling/github-run <workflow> [-f <input>=<value>]...
#
# GitHub drops a job it couldn't find a hosted runner for, after about 15 minutes ("The job was not acquired by
# Runner of type hosted even after multiple attempts"), as it did a macOS arm64 one for an hour on 18 Nov, out of
# capacity. Such a run is run again, as GitHub's own Re-run does, up to 4 times in all; one that ran and failed isn't.
set -euo pipefail

workflow=$1 && shift
run=$(gh workflow run "$workflow" --ref main "$@" 2>&1 | grep -o 'https://github.com/.*/actions/runs/[0-9]*') ||
  { echo "GitHub wasn't asked to run $workflow." >&2 && exit 1; }
echo "Running $workflow on GitHub: $run" >&2
id=${run##*/}
for attempt in 1 2 3 4; do
  gh run watch "$id" --exit-status >/dev/null 2>&1 && echo "$id" && exit
  # A job that never started has no steps.
  [[ $(gh run view "$id" --json jobs --jq '[.jobs[].steps | length] | add // 0') == 0 && $attempt -lt 4 ]] || break
  echo "GitHub found no runner for $workflow's run (attempt $attempt): running it again" >&2
  gh run rerun "$id" >/dev/null
done
echo "$workflow didn't run on GitHub: gh run view $id --log-failed" >&2
exit 1
