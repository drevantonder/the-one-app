# The image `desktop`: a virtual display (TigerVNC's Xvnc, :99, which RandR resizes while it runs, as Xvfb can't) with a
# window manager (Openbox) and Google Chrome on it, for an agent to see with `screenshot` and to drive with xdotool,
# through Chrome's DevTools Protocol on port 9222, or through Playwright's MCP server (`playwright-mcp`), and for a
# person to watch and use as live video (`webrtc-stream`, GStreamer's WebRTC).
#
# It's Google's own Chrome, so a person signs in to it, and to Google, as they would on their own computer. Chrome's
# terms don't let it be passed on, so each machine builds this itself, downloading Chrome from Google, and again each
# week for Chrome's security fixes (`Containers.Podman`). Its policies leave browser sign-in to the person, and turn
# off what a new browser would prompt for, and the warning about the flags a container needs.
FROM docker.io/library/node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends tigervnc-standalone-server x11-xserver-utils openbox xdotool imagemagick x11-utils sqlite3 \
    fonts-dejavu-core fonts-noto-color-emoji ca-certificates curl procps \
    gstreamer1.0-x gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly \
    gstreamer1.0-nice python3-gst-1.0 gir1.2-gst-plugins-bad-1.0 python3-xlib \
 && curl -fsSLo /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_$(dpkg --print-architecture).deb \
 && apt-get install -y --no-install-recommends /tmp/chrome.deb \
 && rm -rf /tmp/chrome.deb /var/lib/apt/lists/* /etc/apt/sources.list.d/google-chrome.list \
 && mkdir -p /etc/opt/chrome/policies/managed \
 && echo '{"BrowserSignin":1,"PromotionsEnabled":false,"DefaultBrowserSettingEnabled":false,"MetricsReportingEnabled":false,"PrivacySandboxPromptEnabled":false,"TranslateEnabled":false,"CommandLineFlagSecurityWarningsEnabled":false}' \
    > /etc/opt/chrome/policies/managed/one.json \
 && npm install -g @playwright/mcp@0.0.85 \
 && npm cache clean --force
ENV DISPLAY=:99 SCREEN=1280x800x24
COPY --chmod=755 desktop.sh /usr/local/bin/desktop
COPY --chmod=755 browser.sh /usr/local/bin/browser
COPY --chmod=755 webrtc-stream.py /usr/local/bin/webrtc-stream
CMD ["desktop"]
