{
  "name": "sign-in",
  "description": "Signing in's edge function: the sign-in page, passkeys, the way in for a device, a browser or an assistant that someone let act as them, the web client's apps' files, and the llms.txt that tells an assistant how.",
  "private": true,
  "type": "module",
  "paths": [
    "sign-in",
    "mcp",
    ".well-known",
    "llms.txt",
    "apps"
  ],
  "scripts": {
    "build": "bun ../../../core/ui/app.js \"$PWD/page\" \"$PWD/files/sign-in\" && cp ../../../icons/Logo.png files/sign-in/mark.png",
    "typecheck": "tsc && tsc -p page"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.25",
    "@better-auth/passkey": "1.7.25",
    "better-auth": "1.7.25",
    "bowser": "2.14.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "typescript": "7.0.2"
  }
}
