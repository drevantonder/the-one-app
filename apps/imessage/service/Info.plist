<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The helper's own, which service/mac-helpers.sh completes: what macOS asks the user in its name. -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>iMessage</string>
  <key>NSAppleEventsUsageDescription</key><string>Your agents send iMessages you ask them to through Messages on this Mac.</string>
  <key>NSContactsUsageDescription</key><string>Messages show who they're from by your contacts' names.</string>
</dict>
</plist>
