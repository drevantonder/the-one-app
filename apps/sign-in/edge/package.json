{
  "name": "sign-in",
  "description": "Signing in's edge function: the sign-in page, passkeys, the devices and assistants someone let act as them, and who a request at the network's address is from.",
  "private": true,
  "type": "module",
  "paths": [
    "sign-in",
    ".well-known",
    "privacy"
  ],
  "who": true,
  "scripts": {
    "build": "bun ../../../core/ui/dist/build/app.js \"$PWD/page\" \"$PWD/files/sign-in\" apps/sign-in/edge/page",
    "typecheck": "tsc && tsc -p page",
    "generate": "bun generate.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.25",
    "@better-auth/mcp": "1.7.25",
    "@better-auth/oauth-provider": "1.7.25",
    "@better-auth/passkey": "1.7.25",
    "@hpke/chacha20poly1305": "1.8.0",
    "@hpke/core": "1.9.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "better-auth": "1.7.25",
    "bowser": "2.14.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "typescript": "7.0.2"
  }
}
