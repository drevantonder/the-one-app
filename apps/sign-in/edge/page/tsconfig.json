{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "ui": ["../../../../core/ui/src/index.ts"],
      "solid-js": ["../../../../core/ui/node_modules/solid-js"],
      "@solidjs/web": ["../../../../core/ui/node_modules/@solidjs/web"],
      "@solidjs/web/jsx-runtime": ["../../../../core/ui/node_modules/@solidjs/web/types/jsx.d.ts"]
    }
  },
  "include": ["**/*", "../../../../core/ui/node_modules/vite/client.d.ts"]
}
