_build/
deps/
target/
node_modules/
*.beam
erl_crash.dump
.DS_Store
# One Core's Rust NIFs as Rustler builds them, a plugin's as they're built beside their source, and the server's
# tests' folders
/core/server/priv/native/
/plugins/*/server/nif/*/*.so
/core/server/tmp/
# What Tauri writes as it builds
/clients/shell/gen/schemas/
# What `wrangler dev` keeps, the secrets of the signer and of a plugin's edge part as whoever deploys an
# edge writes them, and the web client as it's built (each plugin's edge part is built in target/)
.wrangler/
/core/edge/signer/secrets
/plugins/*/edge/secrets
/clients/web/dist/
