_build/
deps/
target/
node_modules/
*.beam
erl_crash.dump
__pycache__/
.DS_Store
# One Core's Rust NIFs as they're built for the server to load and for each kind of machine beside their source, a
# app's NIFs and programs as they're built beside their source
/core/server/priv/native/
/core/server/nif/*/*.so
/apps/*/server/nif/*/*.so
/apps/*/server/bin/*/linux-*
/apps/*/server/bin/*/macos-*
/apps/*/server/bin/*/windows-*
# What Tauri writes as it builds
/clients/app/gen/schemas/
# What `wrangler dev` keeps, the secrets of the presigner and of an app's edge function as whoever deploys an
# edge writes them (the web client and each app's edge function are built in target/)
.wrangler/
/core/edge/presigner/secrets
/apps/*/edge/secrets
/apps/*/edge/files/
/www/app-directory/seed.sql
