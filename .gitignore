_build/
deps/
target/
node_modules/
*.beam
erl_crash.dump
.DS_Store
# One Core's Rust NIFs as they're built for the server to load and for each kind of machine beside their source, a
# plugin's NIFs and programs as they're built beside their source
/core/server/priv/native/
/core/server/nif/*/*.so
/plugins/*/server/nif/*/*.so
/plugins/*/server/bin/*/linux-*
/plugins/*/server/bin/*/macos-*
/plugins/*/server/bin/*/windows-*
# What Tauri writes as it builds
/clients/app/gen/schemas/
# What `wrangler dev` keeps, the secrets of the presigner and of a plugin's edge function as whoever deploys an
# edge writes them, and the web client as it's built (each plugin's edge function is built in target/)
.wrangler/
/core/edge/presigner/secrets
/plugins/*/edge/secrets
/clients/web/dist/
/www/plugin-directory/seed.sql
