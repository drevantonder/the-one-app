{
  // An app's page's: its tsconfig.json extends this, with `"include": ["**/*"]`. A page is written against the
  // UI library alone (src/types): no DOM, no element of the DOM's, no stylesheet, and of the Web APIs only
  // those a Worker has too (globals.d.ts), so it runs on a native host and on the DOM alike. `bun run lint:strict <its folder>` checks it.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "types": [],
    "jsx": "preserve",
    "jsxImportSource": "ui",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "ui": ["./src/types/ui.d.ts"],
      "ui/jsx-runtime": ["./src/types/jsx-runtime.d.ts"],
      "solid-js": ["./node_modules/solid-js"],
      "@solidjs/web": ["./src/types/web.d.ts"]
    }
  },
  "files": ["./src/types/globals.d.ts", "./src/types/solid.d.ts"]
}
