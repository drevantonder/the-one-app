{
  "name": "network-updater",
  "main": "updater.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // Its Durable Object takes a deploy's code once it's idle, or after 5 seconds where it's busy, as the relay's does.
  "durable_objects": {
    "bindings": [{ "name": "UPDATER", "class_name": "NetworkUpdater" }],
    "code_update_strategy": { "mode": "deferred", "max_delay": 5 }
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NetworkUpdater"] }]
}
