{
  "name": "network-relay",
  "main": "relay.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // It tells the network's updater what each server says of itself, and as one comes or goes. The updater is bound
  // to nothing, so it's deployed first.
  "services": [
    { "binding": "NETWORK", "service": "network-presigner", "entrypoint": "Network" },
    { "binding": "UPDATER", "service": "network-updater" }
  ],
  // The relay's Durable Object takes a deploy's code once it hibernates, or after 5 seconds where it's busy, rather
  // than Cloudflare's 5 minutes, so the Worker and it are on different code no longer than the Worker tries a call
  // to it again (`SWITCH` in `relay.ts`).
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }],
    "code_update_strategy": { "mode": "deferred", "max_delay": 5 }
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }]
}
