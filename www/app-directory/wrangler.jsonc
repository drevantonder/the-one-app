{
  "name": "one-www-app-directory",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // Its stylesheet, at /apps/style.css.
  "assets": { "directory": "public" },
  "d1_databases": [
    { "binding": "DB", "database_name": "one-www-app-directory", "database_id": "338b0917-b3b5-4046-bdc1-3e31f4e73434" }
  ],
  // At most 10 installs a minute from one address, counted by Cloudflare's rate limiter, which keeps nothing of ours.
  "ratelimits": [{ "name": "INSTALLS", "namespace_id": "4801", "simple": { "limit": 10, "period": 60 } }]
}
