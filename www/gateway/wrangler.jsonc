{
  "name": "one-www-gateway",
  "main": "gateway.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "one.ptcau.dev", "custom_domain": true }],
  "services": [
    { "binding": "APP_DIRECTORY", "service": "one-www-app-directory" },
    { "binding": "MARKETING", "service": "one-www-marketing" }
  ]
}
